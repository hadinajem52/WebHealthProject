<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins restore to a single, well-known feed. Without this, restore inherits the
    machine-level feeds, and central package management fails with NU1507 when more
    than one source is visible. Keep this list to one entry, or add packageSourceMapping
    below if another feed is ever genuinely required.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
