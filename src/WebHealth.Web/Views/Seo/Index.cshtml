@model SeoListViewModel
@using WebHealth.Application.Seo
@using WebHealth.Domain.Seo
@{
    ViewData.SetTitle("SEO");
    ViewData.SetBreadcrumbs(new BreadcrumbItem("SEO"));
    var listPage = Model.Results;
    var firstVisible = listPage.TotalCount == 0 ? 0 : ((listPage.Page - 1) * listPage.PageSize) + 1;
    var lastVisible = Math.Min(listPage.Page * listPage.PageSize, listPage.TotalCount);
    var hasPrevious = listPage.Page > 1;
    var hasNext = lastVisible < listPage.TotalCount;
}

<div id="ajax-page" class="stack" data-ajax-region>
    
    <section class="card" aria-labelledby="seo-scope-label">
        <p class="card__subtitle" id="seo-scope-label">
            Title, description, canonical and indexing values read from the last successful
            check of each endpoint.
        </p>

        <form method="get" class="filter-bar" data-ajax-form data-ajax-target="#ajax-page" data-ajax-history="push">
            <div class="form-field">
                <label asp-for="Applicability">Applicability</label>
                <select asp-for="Applicability" name="applicability">
                    <option value="">Any</option>
                    <option value="@SeoApplicabilities.Applicable">Applicable</option>
                    <option value="@SeoApplicabilities.NotApplicable">Not applicable</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Environment">Environment</label>
                <select asp-for="Environment" name="environment">
                    <option value="">Any</option>
                    <option value="@SeoQuery.Production">Production</option>
                    <option value="@SeoQuery.NonProduction">Non-production</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Subject">Finding subject</label>
                <select asp-for="Subject" name="subject">
                    <option value="">Any</option>
                    @foreach (var group in SeoFindingGroups.Selectable)
                    {
                        <option value="@group">@group</option>
                    }
                </select>
            </div>
            <label class="switch-field filter-bar__switch">
                <input asp-for="ProblemsOnly" type="checkbox" />
                <span>With SEO findings only</span>
            </label>
            <div class="filter-bar__actions">
                <button class="button button--primary" type="submit">
                    @await Html.PartialAsync("_Icon", "filter")
                    <span>Apply filters</span>
                </button>
                @if (Model.HasFilters)
                {
                    <a class="button button--secondary" asp-action="Index" data-ajax-link data-ajax-target="#ajax-page">
                        @await Html.PartialAsync("_Icon", "close")
                        <span>Clear</span>
                    </a>
                }
            </div>
        </form>
    </section>

    @if (listPage.Items.Count == 0)
    {
        <section class="card">
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                Model.HasFilters
                    ? "No SEO observations match these filters"
                    : "No SEO observations recorded yet",
                "SEO values are extracted from successful HTML responses during ordinary checks.",
                "reports"))
        </section>
    }
    else
    {
        <section class="card" aria-labelledby="seo-results-heading">
            <div class="page-intro">
                <div>
                    <h3 class="card__title" id="seo-results-heading">Observations</h3>
                    
                    <p class="card__status" data-status="neutral">
                        @await Html.PartialAsync("_Icon", "seo")
                        <span>@listPage.TotalCount endpoint@(listPage.TotalCount == 1 ? null : "s") observed</span>
                    </p>
                </div>
            </div>

            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">SEO observations visible to your account</caption>
                    <thead>
                        <tr>
                            <th scope="col">Endpoint</th>
                            <th scope="col">Title</th>
                            <th scope="col">Description</th>
                            <th scope="col">Canonical</th>
                            <th scope="col">Indexing</th>
                            <th scope="col">Findings</th>
                            <th scope="col">Observed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in listPage.Items)
                        {
                            <tr>
                                <td data-label="Endpoint">
                                    <span class="data-table__primary target-url">@item.EndpointUrl</span>
                                    <span class="data-table__secondary">@item.WebsiteName / @item.EnvironmentName</span>
                                </td>
                                @if (item.Applicability == SeoApplicabilities.NotApplicable)
                                {
                                    <td data-label="Values" colspan="4">
                                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                            StatusBadges.Info,
                                            "Not applicable",
                                            item.NotApplicableReason ?? "No reason recorded"))
                                    </td>
                                }
                                else
                                {
                                    
                                    <td data-label="Title">
                                        <span class="data-table__primary">@(string.IsNullOrEmpty(item.Title) ? "—" : item.Title)</span>
                                        @if (!string.IsNullOrEmpty(item.Title))
                                        {
                                            <span class="data-table__secondary">@item.TitleLength characters</span>
                                        }
                                        @if (item.TitleCount > 1)
                                        {
                                            <span class="data-table__secondary">@item.TitleCount titles found</span>
                                        }
                                    </td>
                                    <td data-label="Description">
                                        <span class="data-table__primary">@(string.IsNullOrEmpty(item.MetaDescription) ? "—" : item.MetaDescription)</span>
                                        @if (!string.IsNullOrEmpty(item.MetaDescription))
                                        {
                                            <span class="data-table__secondary">@item.MetaDescriptionLength characters</span>
                                        }
                                    </td>
                                    <td data-label="Canonical">
                                        <span class="data-table__primary target-url">@(item.CanonicalAbsoluteUrl ?? "—")</span>
                                        @if (item.CanonicalCount > 1)
                                        {
                                            <span class="data-table__secondary">@item.CanonicalCount canonicals found</span>
                                        }
                                    </td>
                                    <td data-label="Indexing">
                                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                            item.DeclaresNoIndex ? StatusBadges.Warning : StatusBadges.Success,
                                            item.DeclaresNoIndex ? "noindex" : "Indexable",
                                            $"This environment expects: {SeoListViewModel.DescribeExpectation(item)}"))
                                    </td>
                                }
                                <td data-label="Findings">
                                    @if (item.OpenFindingCount == 0)
                                    {
                                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(StatusBadges.Success, "None"))
                                    }
                                    else
                                    {
                                        <span class="badge-set">
                                            @foreach (var group in item.FindingGroups)
                                            {
                                                
                                                var groupRules = string.Join("; ", item.FindingRuleKeys
                                                    .Where(key => SeoFindingGroups.Of(key) == group.Group)
                                                    .Select(IssueDisplay.DescribeRule));

                                                @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                                    SeoFindingGroups.SiteWide.Contains(group.Group) ? StatusBadges.Danger : StatusBadges.Warning,
                                                    $"{group.Group} {group.Count}",
                                                    groupRules))
                                            }
                                        </span>
                                    }
                                    @if (item.DocumentTruncated)
                                    {
                                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                            StatusBadges.Neutral,
                                            "Truncated",
                                            "The response was longer than the read limit, so these values come from the part that was read."))
                                    }
                                </td>
                                <td data-label="Observed">@Html.Timestamp(item.ObservedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pagination" aria-label="SEO pages">
                <span>Showing @firstVisible–@lastVisible of @listPage.TotalCount</span>
                <span class="pagination__actions">
                    @if (hasPrevious)
                    {
                        <a class="button button--secondary" asp-route-page="@(listPage.Page - 1)" asp-route-applicability="@Model.Applicability" asp-route-environment="@Model.Environment" asp-route-problemsOnly="@Model.ProblemsOnly" asp-route-subject="@Model.Subject" data-ajax-link data-ajax-target="#ajax-page">
                            @await Html.PartialAsync("_Icon", "arrow-left")
                            <span>Previous</span>
                        </a>
                    }
                    @if (hasNext)
                    {
                        <a class="button button--secondary" asp-route-page="@(listPage.Page + 1)" asp-route-applicability="@Model.Applicability" asp-route-environment="@Model.Environment" asp-route-problemsOnly="@Model.ProblemsOnly" asp-route-subject="@Model.Subject" data-ajax-link data-ajax-target="#ajax-page">
                            <span>Next</span>
                            @await Html.PartialAsync("_Icon", "arrow-right")
                        </a>
                    }
                </span>
            </nav>
        </section>
    }
</div>
