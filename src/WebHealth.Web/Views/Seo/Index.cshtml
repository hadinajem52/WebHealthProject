@model SeoListViewModel
@using WebHealth.Application.Seo
@using WebHealth.Domain.Seo
@{
    ViewData.SetTitle("SEO");
    ViewData.SetBreadcrumbs(new BreadcrumbItem("SEO"));
    var listPage = Model.Results;
    var firstVisible = listPage.TotalCount == 0 ? 0 : ((listPage.Page - 1) * listPage.PageSize) + 1;
    var lastVisible = Math.Min(listPage.Page * listPage.PageSize, listPage.TotalCount);
    var hasPrevious = listPage.Page > 1;
    var hasNext = lastVisible < listPage.TotalCount;
}

<div class="stack">
    <section class="card">
        <div class="page-intro">
            <div>
                <h2 class="card__title">SEO</h2>
                <p class="card__subtitle">Title, description, canonical and indexing values read from the last successful check of each endpoint.</p>
            </div>
            <span class="tag">@listPage.TotalCount endpoint@(listPage.TotalCount == 1 ? null : "s")</span>
        </div>

        <form method="get" class="filter-grid">
            <div class="form-field">
                <label asp-for="Applicability">Applicability</label>
                <select asp-for="Applicability" name="applicability">
                    <option value="">Any</option>
                    <option value="@SeoApplicabilities.Applicable">Applicable</option>
                    <option value="@SeoApplicabilities.NotApplicable">Not applicable</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Environment">Environment</label>
                <select asp-for="Environment" name="environment">
                    <option value="">Any</option>
                    <option value="@SeoQuery.Production">Production</option>
                    <option value="@SeoQuery.NonProduction">Non-production</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Subject">Finding subject</label>
                <select asp-for="Subject" name="subject">
                    <option value="">Any</option>
                    @foreach (var group in SeoFindingGroups.Selectable)
                    {
                        <option value="@group">@group</option>
                    }
                </select>
            </div>
            <label class="switch-field">
                @* No name override: asp-for emits a hidden false companion under the model
                   property's own name, so renaming only the visible input submits the value
                   twice under two spellings of one case-insensitive parameter. *@
                <input asp-for="ProblemsOnly" type="checkbox" />
                <span>With SEO findings only</span>
            </label>
            <div class="filter-grid__actions">
                <button class="button button--primary" type="submit">
                    @await Html.PartialAsync("_Icon", "filter")
                    <span>Apply filters</span>
                </button>
                <a class="button button--secondary" asp-action="Index">
                    @await Html.PartialAsync("_Icon", "close")
                    <span>Clear</span>
                </a>
            </div>
        </form>

        <p class="card__subtitle">@Model.FilterSummary</p>

        @if (listPage.Items.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                Model.HasFilters
                    ? "No SEO observations match these filters"
                    : "No SEO observations recorded yet",
                "SEO values are extracted from successful HTML responses during ordinary checks.",
                "reports"))
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">SEO observations visible to your account</caption>
                    <thead>
                        <tr>
                            <th scope="col">Endpoint</th>
                            <th scope="col">Title</th>
                            <th scope="col">Description</th>
                            <th scope="col">Canonical</th>
                            <th scope="col">Indexing</th>
                            <th scope="col">Findings</th>
                            <th scope="col">Observed</th>
                            <th scope="col"><span class="visually-hidden">PageSpeed</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in listPage.Items)
                        {
                            <tr>
                                <td data-label="Endpoint">
                                    <span class="data-table__primary target-url">@item.EndpointUrl</span>
                                    <span class="data-table__secondary">@item.WebsiteName / @item.EnvironmentName</span>
                                </td>
                                @if (item.Applicability == SeoApplicabilities.NotApplicable)
                                {
                                    @* One cell across the value columns: a non-HTML response has no
                                       SEO values, and rendering four dashes would look like four
                                       separate problems rather than one reason. *@
                                    <td data-label="Values" colspan="4">
                                        <span class="badge" data-status="@StatusBadges.Info">Not applicable</span>
                                        <span class="data-table__secondary">@(item.NotApplicableReason ?? "No reason recorded")</span>
                                    </td>
                                }
                                else
                                {
                                    <td data-label="Title">
                                        @SeoListViewModel.Present(item.Title, item.TitleLength)
                                        @if (item.TitleCount > 1)
                                        {
                                            <span class="tag">@item.TitleCount titles</span>
                                        }
                                    </td>
                                    <td data-label="Description">@SeoListViewModel.Present(item.MetaDescription, item.MetaDescriptionLength)</td>
                                    <td data-label="Canonical">
                                        <span class="target-url">@(item.CanonicalAbsoluteUrl ?? "—")</span>
                                        @if (item.CanonicalCount > 1)
                                        {
                                            <span class="tag">@item.CanonicalCount canonicals</span>
                                        }
                                    </td>
                                    <td data-label="Indexing">
                                        <span class="badge" data-status="@(item.DeclaresNoIndex ? "warning" : "success")">
                                            @(item.DeclaresNoIndex ? "noindex" : "Indexable")
                                        </span>
                                        <span class="data-table__secondary">Expected: @SeoListViewModel.DescribeExpectation(item)</span>
                                    </td>
                                }
                                <td data-label="Findings">
                                    @if (item.OpenFindingCount == 0)
                                    {
                                        <span class="badge" data-status="success">None</span>
                                    }
                                    else
                                    {
                                        @* §11.2 asks for robots and sitemap findings by name. Every
                                           SEO rule shares one key prefix, so a bare total cannot
                                           tell a blocked origin from a missing description — the
                                           subject is named, and the rule spelled out beneath it. *@
                                        <span class="finding-groups">
                                            @foreach (var group in item.FindingGroups)
                                            {
                                                <span class="badge"
                                                      data-status="@(SeoFindingGroups.SiteWide.Contains(group.Group) ? "danger" : "warning")">
                                                    @group.Group @group.Count
                                                </span>
                                            }
                                        </span>
                                        <span class="data-table__secondary">
                                            @string.Join("; ", item.FindingRuleKeys.Select(IssueDisplay.DescribeRule))
                                        </span>
                                    }
                                    @if (item.DocumentTruncated)
                                    {
                                        @* BR-E10: absence rules cannot be trusted on a document that
                                           was cut short, so the reader is told rather than left to
                                           read a missing value as a missing tag. *@
                                        <span class="data-table__secondary">Response was truncated</span>
                                    }
                                </td>
                                <td data-label="Observed">@Html.Timestamp(item.ObservedAt)</td>
                                @* A link rather than a score column. The score belongs to a
                                   different provider on a different cadence, and reading it here
                                   would put a Lighthouse number beside WebHealth's own findings as
                                   though the two were one judgement. *@
                                <td data-label="PageSpeed">
                                    <a class="button button--secondary" asp-controller="PageAudits" asp-action="Index" asp-route-endpointId="@item.EndpointId">
                                        <span>PageSpeed</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pagination" aria-label="SEO pages">
                <span>Showing @firstVisible–@lastVisible of @listPage.TotalCount</span>
                <span class="pagination__actions">
                    @if (hasPrevious)
                    {
                        <a class="button button--secondary" asp-route-page="@(listPage.Page - 1)" asp-route-applicability="@Model.Applicability" asp-route-environment="@Model.Environment" asp-route-problemsOnly="@Model.ProblemsOnly" asp-route-subject="@Model.Subject">
                            @await Html.PartialAsync("_Icon", "arrow-left")
                            <span>Previous</span>
                        </a>
                    }
                    @if (hasNext)
                    {
                        <a class="button button--secondary" asp-route-page="@(listPage.Page + 1)" asp-route-applicability="@Model.Applicability" asp-route-environment="@Model.Environment" asp-route-problemsOnly="@Model.ProblemsOnly" asp-route-subject="@Model.Subject">
                            <span>Next</span>
                            @await Html.PartialAsync("_Icon", "arrow-right")
                        </a>
                    }
                </span>
            </nav>
        }
    </section>
</div>
