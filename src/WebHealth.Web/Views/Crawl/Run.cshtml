@model CrawlRunViewModel
@using WebHealth.Domain.Crawling
@{
    ViewData.SetTitle("Crawl run");
    ViewData.SetBreadcrumbs(
        new BreadcrumbItem("Broken links", "/Crawl"),
        new BreadcrumbItem("Crawl run"));
    var run = Model.Run;
    var runTone = CrawlRunDisplay.StatusTone(run);
    var isRunning = run.Status == CrawlRunStatuses.Running;

    static string StatusIcon(string tone) => tone switch
    {
        "success" => "success",
        "danger" => "error",
        "warning" => "warning",
        "info" => "information",
        _ => "clock"
    };
}


<div id="ajax-page"
     class="stack"
     data-ajax-region
     data-live-run-scope="#ajax-page"
     data-live-run-status-url="@(isRunning ? Url.Action("LiveStatus", new { id = run.RunId }) : null)"
     data-live-run-final-url="@Url.Action("Run", new { id = run.RunId, offset = Model.Offset })"
     data-live-run-results-url="@Url.Action("Results", new { id = run.RunId, offset = Model.Offset })"
     data-live-run-results-selector="#crawl-broken-links-results"
     data-live-run-version="@run.Status:@run.PagesFetched:@run.LinksRecorded"
     data-live-run-lifetime="1860000">
    
    <section class="card" aria-labelledby="crawl-run-label">
        <div class="page-intro">
            <div>
                <p class="card__status" data-status="@runTone" id="crawl-run-label">
                    @if (isRunning)
                    {
                        @await Html.PartialAsync("_Spinner", $"crawl-run-summary-{run.RunId}")
                    }
                    else
                    {
                        @await Html.PartialAsync("_Icon", StatusIcon(runTone))
                    }
                    <span>@CrawlRunDisplay.DescribeStatus(run) &middot; @CrawlRunDisplay.DescribeStopReason(run)</span>
                </p>
            </div>
            <div class="form-actions">
                <a class="button button--secondary" asp-action="Index" asp-route-endpointId="@run.EndpointId">
                    @await Html.PartialAsync("_Icon", "arrow-left")
                    <span>Back to crawl history</span>
                </a>
            </div>
        </div>

        <div class="detail-list">
            <div class="detail-list__head" aria-hidden="true">
                <span>Subject</span>
                <span>Status</span>
            </div>
            <ul class="detail-list__items">
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                            <span>Started</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(run.StartedAt)</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "check")</span>
                            <span>Finished</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(run.FinishedAt, "Still running")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "audit")</span>
                            <span>Pages fetched</span>
                        </span>
                        <span class="detail-list__value" data-live="pages">@run.PagesFetched</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "link")</span>
                            <span>Links recorded</span>
                        </span>
                        <span class="detail-list__value" data-live="links">@run.LinksRecorded</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "broken-link")</span>
                            <span>Broken links</span>
                        </span>
                        <span class="detail-list__value">
                            @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                isRunning
                                    ? StatusBadges.Info
                                    : run.BrokenLinkCount == 0 ? StatusBadges.Success : StatusBadges.Warning,
                                run.BrokenLinkCount.ToString(),
                                run.CoveredWholeScope
                                    ? null
                                    : "This crawl did not cover the whole scope, so links it never reached are not counted.",
                                LiveKey: isRunning ? "broken" : null))
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "seo")</span>
                            <span>Covered whole scope</span>
                        </span>
                        <span class="detail-list__value">
                            
                            @if (isRunning)
                            {
                                @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                    StatusBadges.Info,
                                    "Not yet",
                                    "The crawl is still running, so how much of the site it covers is not settled.",
                                    true,
                                    $"crawl-run-coverage-{run.RunId}"))
                            }
                            else
                            {
                                @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                    run.CoveredWholeScope ? StatusBadges.Success : StatusBadges.Warning,
                                    run.CoveredWholeScope ? "Yes" : "No",
                                    CrawlRunDisplay.DescribeStopReason(run)))
                            }
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "shield")</span>
                            <span>Robots override</span>
                        </span>
                        <span class="detail-list__value">
                            @(run.RobotsOverrideGranted
                                ? "Granted"
                                : CrawlRunDisplay.DescribeOverrideRefusal(run.RobotsOverrideRefusedBecause))
                        </span>
                    </div>
                </li>
                
                @if (run.Status == CrawlRunStatuses.Failed)
                {
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "error")</span>
                                <span>Why it failed</span>
                            </span>
                            <span class="detail-list__value">@CrawlRunDisplay.DescribeFailure(run)</span>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </section>

    
    @if (Model.Skips.Count > 0)
    {
        var skipped = Model.Skips.Sum(skip => skip.Count);
        <section class="card" aria-labelledby="crawl-skips-heading">
            <div class="page-intro">
                <div>
                    <h3 class="card__title" id="crawl-skips-heading">
                        @(Model.ExaminedNothing ? "Why nothing was crawled" : "URLs the crawl did not request")
                    </h3>
                    <p class="card__status" data-status="@(Model.ExaminedNothing ? "warning" : "neutral")">
                        @await Html.PartialAsync("_Icon", Model.ExaminedNothing ? "warning" : "information")
                        <span>@skipped URL@(skipped == 1 ? null : "s") skipped</span>
                    </p>
                </div>
            </div>

            <p class="card__subtitle">
                A skipped URL was never requested, so it is neither healthy nor broken. Nothing here
                is counted as a broken link.
            </p>

            <div class="detail-list">
                <div class="detail-list__head" aria-hidden="true">
                    <span>Reason</span>
                    <span>URLs</span>
                </div>
                <ul class="detail-list__items">
                    @foreach (var skip in Model.Skips)
                    {
                        <li>
                            <div class="detail-list__row">
                                <span class="detail-list__subject">
                                    <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "shield")</span>
                                    <span>@CrawlRunDisplay.DescribeSkipReason(skip.SkipReason)</span>
                                </span>
                                <span class="detail-list__value">@skip.Count</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    <section class="card" aria-labelledby="crawl-broken-heading">
        <div class="page-intro">
            <div>
                <h3 class="card__title" id="crawl-broken-heading">Broken links</h3>
                <p class="card__status" data-status="@(isRunning ? "info" : run.BrokenLinkCount == 0 ? "success" : "warning")">
                    @await Html.PartialAsync("_Icon", isRunning ? "information" : run.BrokenLinkCount == 0 ? "success" : "warning")
                    <span><span data-live="broken">@run.BrokenLinkCount</span> recorded by this crawl</span>
                </p>
            </div>
        </div>

        <p class="card__subtitle">
            Each row is one link on one page, so a page linking to the same broken URL twice
            appears once.
        </p>

        @await Html.PartialAsync("_BrokenLinksTable", new CrawlBrokenLinksRegionViewModel(
            run.RunId, Model.BrokenLinks, Model.Offset, Model.PageSize, run.CoveredWholeScope))
    </section>
</div>

@section Scripts {
    <script src="~/js/poller.js" asp-append-version="true"></script>
    <script src="~/js/live-run-status.js" asp-append-version="true"></script>
}
