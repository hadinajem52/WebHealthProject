@using WebHealth.Application.Seo
@using WebHealth.Domain.PageAudits
@model EndpointFormViewModel
@using WebHealth.Application.Registry



<fieldset class="form-section">
    <legend class="form-section__title">Endpoint</legend>
    <p class="form-section__hint">The address to watch, and who answers for it.</p>

    <div class="form-section__body">
        <div class="form-field">
            <label asp-for="Url">
                @Html.DisplayNameFor(model => model.Url)
                <span class="form-field__required">Required</span>
            </label>
            <input asp-for="Url" type="text" inputmode="url" spellcheck="false"
                   autocapitalize="none" placeholder="example.com/health" />
            <span class="form-field__hint">
                Type the address alone, such as example.com, and https:// is added for you.
                Credentials, fragments and relative URLs are rejected.
            </span>
            <span asp-validation-for="Url"></span>
        </div>

        <div class="form-field">
            <label asp-for="OwnerSubjectId">
                @Html.DisplayNameFor(model => model.OwnerSubjectId)
                <span class="form-field__optional">Optional</span>
            </label>
            <select asp-for="OwnerSubjectId">
                <option value="">Inherit website owner</option>
                @foreach (var owner in Model.Owners)
                {
                    <option value="@owner.OwnerSubjectId">@owner.DisplayName (@owner.OwnerType)</option>
                }
            </select>
            <span class="form-field__hint">
                Leave inherited unless this one endpoint is somebody else's responsibility.
            </span>
            <span asp-validation-for="OwnerSubjectId"></span>
        </div>
    </div>
</fieldset>

<fieldset class="form-section">
    <legend class="form-section__title">Availability checks</legend>
    <p class="form-section__hint">
        How often this endpoint is checked, and when a slow response counts as a problem.
    </p>

    <div class="form-section__body">
        <div class="switch-block">
            <label class="switch-field">
                <input asp-for="IsEnabled" type="checkbox" aria-describedby="endpoint-enabled-hint" />
                <span>Endpoint enabled</span>
            </label>
            <span class="form-field__hint" id="endpoint-enabled-hint">
                Off keeps the endpoint and its history, and stops every kind of check.
            </span>
        </div>

        <div class="switch-block">
            <label class="switch-field">
                <input asp-for="SchedulingEnabled" type="checkbox"
                       data-shell-scheduling-toggle aria-describedby="endpoint-scheduling-hint" />
                <span>Run scheduled checks</span>
            </label>
            <span class="form-field__hint" id="endpoint-scheduling-hint">
                Off means on-demand only: Run now still works, nothing runs on a timer.
            </span>
        </div>

        
        <div class="form-dependent" data-shell-interval-field
             data-inactive="@((!Model.SchedulingEnabled).ToString().ToLowerInvariant())">
            <div class="form-field">
                <label asp-for="IntervalMinutesOverride">
                    @Html.DisplayNameFor(model => model.IntervalMinutesOverride)
                    <span class="form-field__optional">Optional</span>
                </label>
                <input asp-for="IntervalMinutesOverride" type="number" min="1" max="1440"
                       readonly="@((!Model.CanConfigureInterval || !Model.SchedulingEnabled) ? "readonly" : null)"
                       data-shell-interval-input
                       data-permission-locked="@((!Model.CanConfigureInterval).ToString().ToLowerInvariant())" />
                <span class="form-field__hint">
                    Blank uses the default: 5 minutes for Production, 15 for everything else.
                    @if (!Model.CanConfigureInterval)
                    {
                        <text>Only an Administrator can change this.</text>
                    }
                </span>
                <span asp-validation-for="IntervalMinutesOverride"></span>
            </div>
        </div>

        
        <div class="form-grid form-grid--two">
            <div class="form-field">
                <label asp-for="WarningThresholdMsOverride">
                    @Html.DisplayNameFor(model => model.WarningThresholdMsOverride)
                    <span class="form-field__optional">Optional</span>
                </label>
                <input asp-for="WarningThresholdMsOverride" type="number"
                       min="@ResponseThresholdOverride.MinimumMs" max="@ResponseThresholdOverride.MaximumMs"
                       placeholder="1500" />
                <span asp-validation-for="WarningThresholdMsOverride"></span>
            </div>

            <div class="form-field">
                <label asp-for="CriticalThresholdMsOverride">
                    @Html.DisplayNameFor(model => model.CriticalThresholdMsOverride)
                    <span class="form-field__optional">Optional</span>
                </label>
                <input asp-for="CriticalThresholdMsOverride" type="number"
                       min="@ResponseThresholdOverride.MinimumMs" max="@ResponseThresholdOverride.MaximumMs"
                       placeholder="3000" />
                <span asp-validation-for="CriticalThresholdMsOverride"></span>
            </div>
        </div>
        <span class="form-field__hint">
            Critical must be at or above warning and no greater than the HTTP timeout. Each blank field uses the
            1,500 ms and 3,000 ms defaults, and a response at or above a threshold breaches it.
        </span>
    </div>
</fieldset>

<fieldset class="form-section">
    <legend class="form-section__title">SEO expectations</legend>
    <p class="form-section__hint">
        What this page should look like to a search engine. Findings are raised against these.
    </p>

    <div class="form-section__body">
        <div class="form-field">
            <label asp-for="SeoIndexingExpectation"></label>
            <select asp-for="SeoIndexingExpectation" class="form-select">
                <option value="@SeoIndexingExpectations.Default">Default for this environment</option>
                <option value="@SeoIndexingExpectations.Indexable">Must be indexable</option>
                <option value="@SeoIndexingExpectations.NoIndex">Must carry noindex</option>
            </select>
            <span class="form-field__hint">
                The default expects Production to be indexable and everything else to carry
                <code>noindex</code>.
            </span>
            <span asp-validation-for="SeoIndexingExpectation"></span>
        </div>

        <div class="form-field">
            <label asp-for="SeoExpectedCanonicalHost">
                @Html.DisplayNameFor(model => model.SeoExpectedCanonicalHost)
                <span class="form-field__optional">Optional</span>
            </label>
            <input asp-for="SeoExpectedCanonicalHost" autocomplete="off" placeholder="www.example.com" />
            <span class="form-field__hint">Blank expects the endpoint's own host.</span>
            <span asp-validation-for="SeoExpectedCanonicalHost"></span>
        </div>

        
        <div class="switch-block">
            <label class="switch-field">
                <input asp-for="SeoDescriptionRequired" type="checkbox" aria-describedby="seo-description-hint" />
                <span>@Html.DisplayNameFor(model => model.SeoDescriptionRequired)</span>
            </label>
            <span class="form-field__hint" id="seo-description-hint">
                Off stops the missing meta description finding for this endpoint.
            </span>
        </div>
    </div>
</fieldset>

<fieldset class="form-section">
    <legend class="form-section__title">Google PageSpeed audits</legend>
    <p class="form-section__hint">
        Optional performance, accessibility, best-practices, and SEO scores from Google PageSpeed
        Insights. Each full audit covers four categories on mobile and desktop, using eight Google
        requests.
    </p>

    <div class="form-section__body">
        <div class="switch-block">
            <label class="switch-field">
                <input asp-for="PageAuditEnabled" type="checkbox" data-shell-dependency="page-audits" />
                <span>Enable Google PageSpeed audits</span>
            </label>
        </div>

        <div class="form-dependent" data-shell-dependent-on="page-audits"
             data-inactive="@((!Model.PageAuditEnabled).ToString().ToLowerInvariant())">
            <div class="switch-block">
                <label class="switch-field">
                    <input asp-for="PageAuditSchedulingEnabled" type="checkbox"
                           data-shell-scheduling-toggle="page-audit-interval" aria-describedby="page-audit-schedule-hint" />
                    <span>Run PageSpeed audits on a schedule</span>
                </label>
                <span class="form-field__hint" id="page-audit-schedule-hint">
                    Off keeps audits on demand. Turning it off keeps every score already recorded.
                </span>
            </div>

            <div class="form-dependent" data-shell-interval-field="page-audit-interval"
                 data-inactive="@((!Model.PageAuditSchedulingEnabled).ToString().ToLowerInvariant())">
                <div class="form-field">
                    <label asp-for="PageAuditIntervalHours"></label>
                    <input asp-for="PageAuditIntervalHours" type="number"
                           min="@PageAuditCadence.MinimumIntervalHours" max="@PageAuditCadence.MaximumIntervalHours"
                           readonly="@(!Model.PageAuditSchedulingEnabled ? "readonly" : null)"
                           data-shell-interval-input="page-audit-interval" />
                    <span class="form-field__hint">
                        Between @PageAuditCadence.MinimumIntervalHours hours and
                        @(PageAuditCadence.MaximumIntervalHours / 24) days. Each run asks Google to
                        load the page for four categories on both form factors, so daily is usually enough.
                    </span>
                    <span asp-validation-for="PageAuditIntervalHours"></span>
                </div>
            </div>
        </div>
    </div>
</fieldset>

@if (Model.IsProduction)
{

}

@Html.EditorFor(model => model.HttpPolicy)
