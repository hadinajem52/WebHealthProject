@model EndpointDetailsViewModel
@{
    ViewData.SetTitle("Endpoint");
    ViewData.SetBreadcrumbs(
        Breadcrumbs.Registry(Url),
        Breadcrumbs.Websites(Url),
        Breadcrumbs.Website(Url, Model.Endpoint.WebsiteId, Model.Endpoint.WebsiteName),
        Breadcrumbs.Environments(Url, Model.Endpoint.WebsiteId),
        Breadcrumbs.Environment(Url, Model.Endpoint.EnvironmentId, Model.Endpoint.EnvironmentName),
        new BreadcrumbItem(Model.Endpoint.DisplayUrl));

    string? notTestableReason = Model.Endpoint.CanTest ? null
        : Model.Endpoint.IsDeleted ? "endpoint is archived"
        : !Model.Endpoint.IsEnabled ? "endpoint is disabled"
        : "you are not authorized to test this target";

    var endpointStatus = Model.Endpoint.IsDeleted ? "danger"
        : Model.Endpoint.IsEnabled ? "success"
        : "warning";
    var endpointStatusLabel = Model.Endpoint.IsDeleted ? "Archived"
        : Model.Endpoint.IsEnabled ? "Enabled"
        : "Disabled";

    var certificate = Model.Certificate.Latest;
    var certificateValid = certificate is not null && certificate.ValidationCategory == "Valid";
    var certificateStatus = !Model.Certificate.IsMonitored ? "warning"
        : certificate is null ? "warning"
        : certificateValid ? "success"
        : "danger";
    var certificateStatusLabel = !Model.Certificate.IsMonitored ? "Not applicable"
        : certificate is null ? "Not checked yet"
        : certificate.ValidationCategory;

    var latest = Model.LatestCheck;

    static string StatusIcon(string status) => status switch
    {
        "success" => "success",
        "danger" => "error",
        _ => "warning"
    };
}

<section class="card" aria-labelledby="endpoint-heading">
    <div class="page-intro">
        <div>
            <h2 class="card__title target-url" id="endpoint-heading">@Model.Endpoint.DisplayUrl</h2>
            <p class="card__status" data-status="@endpointStatus">
                @await Html.PartialAsync("_Icon", StatusIcon(endpointStatus))
                <span>Endpoint status &middot; @endpointStatusLabel</span>
            </p>
        </div>

        <div class="form-actions">
            <a class="button button--secondary button--icon"
               asp-controller="Checks"
               asp-action="History"
               asp-route-id="@Model.Endpoint.Id"
               title="Check history"
               aria-label="Check history">
                @await Html.PartialAsync("_Icon", "clock")
            </a>

            @if (Model.Endpoint.CanTest)
            {
                <div class="action-menu" data-shell-menu data-open="false">
                    <button type="button"
                            class="button button--primary"
                            data-shell-menu-toggle
                            aria-controls="endpoint-run-menu"
                            aria-expanded="false"
                            aria-haspopup="true">
                        @await Html.PartialAsync("_Icon", "play")
                        <span>Run</span>
                        <span class="button__caret">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                    </button>

                    <div class="action-menu__panel" id="endpoint-run-menu" data-shell-menu-panel>
                        <form asp-controller="Checks" asp-action="RunCheck" asp-route-id="@Model.Endpoint.Id" method="post">
                            <button class="action-menu__item" type="submit">
                                @await Html.PartialAsync("_Icon", "activity")
                                <span>Run availability check</span>
                            </button>
                        </form>
                        @if (Model.Certificate.IsMonitored)
                        {
                            <form asp-controller="Checks" asp-action="RunCertificateCheck" asp-route-id="@Model.Endpoint.Id" method="post">
                                <button class="action-menu__item" type="submit">
                                    @await Html.PartialAsync("_Icon", "shield-check")
                                    <span>Run certificate check</span>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }

            @if (Model.CanManage && !Model.Endpoint.IsDeleted)
            {
                <a class="button button--primary" asp-action="EditEndpoint" asp-route-id="@Model.Endpoint.Id">
                    @await Html.PartialAsync("_Icon", "pencil")
                    <span>Edit</span>
                </a>
            }

            @if (Model.CanManage)
            {
                <div class="action-menu" data-shell-menu data-open="false">
                    <button type="button"
                            class="button button--secondary"
                            data-shell-menu-toggle
                            aria-controls="endpoint-actions-menu"
                            aria-expanded="false"
                            aria-haspopup="true">
                        @await Html.PartialAsync("_Icon", "settings")
                        <span>Actions</span>
                        <span class="button__caret">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                    </button>

                    <div class="action-menu__panel" id="endpoint-actions-menu" data-shell-menu-panel>
                        @if (Model.Endpoint.IsDeleted)
                        {
                            <form asp-action="RestoreEndpoint" method="post">
                                <input type="hidden" name="id" value="@Model.Endpoint.Id" />
                                <input type="hidden" name="version" value="@Model.Endpoint.Version" />
                                <button class="action-menu__item" type="submit">
                                    @await Html.PartialAsync("_Icon", "restore")
                                    <span>Restore endpoint</span>
                                </button>
                            </form>
                            @if (Model.CanPurge)
                            {
                                <hr class="action-menu__separator" />
                                <form asp-action="PurgeEndpoint"
                                      method="post"
                                      data-shell-confirm="Permanently delete this endpoint and all of its checks, results, SEO observations, crawls, incidents and notifications? This cannot be undone.">
                                    <input type="hidden" name="id" value="@Model.Endpoint.Id" />
                                    <input type="hidden" name="version" value="@Model.Endpoint.Version" />
                                    <button class="action-menu__item action-menu__item--danger" type="submit">
                                        @await Html.PartialAsync("_Icon", "trash")
                                        <span>Delete permanently</span>
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            @if (Model.Endpoint.IsEnabled)
                            {
                                <form asp-action="DisableEndpoint" method="post">
                                    <input type="hidden" name="id" value="@Model.Endpoint.Id" />
                                    <input type="hidden" name="version" value="@Model.Endpoint.Version" />
                                    <button class="action-menu__item" type="submit">
                                        @await Html.PartialAsync("_Icon", "power")
                                        <span>Disable</span>
                                    </button>
                                </form>
                            }

                            @if (Model.Endpoint.IsEnabled && Model.Endpoint.SchedulingEnabled)
                            {
                                <form asp-action="@(Model.Endpoint.MonitorEnabled ? "PauseEndpointSchedule" : "ResumeEndpointSchedule")" method="post">
                                    <input type="hidden" name="id" value="@Model.Endpoint.Id" />
                                    <input type="hidden" name="version" value="@Model.Endpoint.Version" />
                                    <button class="action-menu__item" type="submit">
                                        @await Html.PartialAsync("_Icon", Model.Endpoint.MonitorEnabled ? "pause" : "play")
                                        <span>@(Model.Endpoint.MonitorEnabled ? "Pause checks" : "Resume checks")</span>
                                    </button>
                                </form>
                            }

                            <hr class="action-menu__separator" />
                            <form asp-action="DeleteEndpoint" method="post">
                                <input type="hidden" name="id" value="@Model.Endpoint.Id" />
                                <input type="hidden" name="version" value="@Model.Endpoint.Version" />
                                <button class="action-menu__item action-menu__item--danger" type="submit">
                                    @await Html.PartialAsync("_Icon", "archive")
                                    <span>Archive endpoint</span>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="detail-list">
        <div class="detail-list__head" aria-hidden="true">
            <span>Subject</span>
            <span>Status</span>
        </div>
        <ul class="detail-list__items">
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "activity")</span>
                        <span>Status</span>
                    </span>
                    <span class="detail-list__value">
                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(endpointStatus, endpointStatusLabel))
                    </span>
                </div>
            </li>
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "person")</span>
                        <span>Owner</span>
                    </span>
                    <span class="detail-list__value">
                        <span>@Model.Endpoint.OwnerName</span>
                        @if (Model.Endpoint.InheritsWebsiteOwner)
                        {
                            <span class="detail-list__note">Website inherited</span>
                        }
                    </span>
                </div>
            </li>
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "settings")</span>
                        <span>Monitor configuration</span>
                    </span>
                    <span class="detail-list__value">
                        @Model.Endpoint.MonitorType &middot; every @(Model.Endpoint.IntervalSeconds / 60) min @(Model.Endpoint.IntervalMinutesOverride is null ? "(environment default)" : "(endpoint override)") &middot; @(Model.Endpoint.TimeoutSeconds)s timeout
                    </span>
                </div>
            </li>
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "speed")</span>
                        <span>Response-time thresholds</span>
                    </span>
                    <span class="detail-list__value">
                        @(Model.Endpoint.WarningThresholdMs) ms warning &middot; @(Model.Endpoint.CriticalThresholdMs) ms critical
                        <span class="detail-list__note">@(Model.Endpoint.HasThresholdOverride ? "Endpoint override" : "Default")</span>
                    </span>
                </div>
            </li>
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                        <span>Effective monitoring</span>
                    </span>
                    <span class="detail-list__value">
                        @(!Model.Endpoint.SchedulingEnabled ? "Manual runs only"
                            : !Model.Endpoint.MonitorEnabled ? "Paused — manual runs only"
                            : Model.Endpoint.IsMonitoringEligible ? "Eligible" : "Not eligible")
                    </span>
                </div>
            </li>
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "shield")</span>
                        <span>Testing authorization</span>
                    </span>
                    <span class="detail-list__value">
                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                            Model.Endpoint.CanTest ? StatusBadges.Success : StatusBadges.Warning,
                            Model.Endpoint.CanTest ? "Authorized" : "Not authorized"))
                        @if (notTestableReason is not null)
                        {
                            <span class="detail-list__note">@notTestableReason</span>
                        }
                    </span>
                </div>
            </li>
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "audit")</span>
                        <span>Target evidence</span>
                    </span>
                    <span class="detail-list__value">
                        @(Model.CanManage
                            ? Model.Endpoint.TargetAuthorizationEvidence ?? "Not recorded"
                            : Model.Endpoint.HasTargetAuthorization ? "Recorded" : "Not recorded")
                    </span>
                </div>
            </li>
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "link")</span>
                        <span>Canonical URL v@(Model.Endpoint.NormalizationVersion)</span>
                    </span>
                    <span class="detail-list__value target-url">@Model.Endpoint.NormalizedUrl</span>
                </div>
            </li>
            <li>
                <div class="detail-list__row">
                    <span class="detail-list__subject">
                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "warning")</span>
                        <span>Production HTTP exception</span>
                    </span>
                    <span class="detail-list__value">
                        @(Model.CanManage
                            ? Model.Endpoint.HttpExceptionReason ?? "Not required"
                            : Model.Endpoint.HasHttpException ? "Recorded" : "Not required")
                    </span>
                </div>
            </li>
        </ul>
    </div>
</section>

<section class="card" aria-labelledby="endpoint-certificate-heading">
    <div class="page-intro">
        <div>
            <h2 class="card__title" id="endpoint-certificate-heading">Certificate</h2>
            <p class="card__status" data-status="@certificateStatus">
                @await Html.PartialAsync("_Icon", StatusIcon(certificateStatus))
                <span>Certificate status &middot; @certificateStatusLabel</span>
            </p>
        </div>
    </div>

    @if (!Model.Certificate.IsMonitored)
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
            "Not applicable",
            "This endpoint uses HTTP, so it presents no certificate to check.",
            "information"))
    }
    else if (certificate is null)
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
            "No certificate checked yet",
            "Certificates are checked once a day. The first result will appear after the next run.",
            "clock"))
    }
    else
    {
        <div class="detail-list">
            <div class="detail-list__head" aria-hidden="true">
                <span>Subject</span>
                <span>Status</span>
            </div>
            <ul class="detail-list__items">
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "shield-check")</span>
                            <span>Validation</span>
                        </span>
                        <span class="detail-list__value">
                            @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                certificateValid ? StatusBadges.Success : StatusBadges.Danger,
                                certificate.ValidationCategory))
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "person")</span>
                            <span>Subject</span>
                        </span>
                        <span class="detail-list__value">@certificate.Subject</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "building")</span>
                            <span>Issuer</span>
                        </span>
                        <span class="detail-list__value">@certificate.Issuer</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                            <span>Expiry</span>
                        </span>
                        <span class="detail-list__value">
                            @if (certificateValid)
                            {
                                @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                    StatusBadges.ForExpirySeverity(certificate.ExpirySeverity),
                                    StatusBadges.DescribeExpirySeverity(certificate.ExpirySeverity)))
                            }
                            else
                            {
                                <span class="detail-list__note">Not applicable while the certificate is @certificate.ValidationCategory.</span>
                            }
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "calendar")</span>
                            <span>Valid until</span>
                        </span>
                        <span class="detail-list__value">
                            @Html.Timestamp(certificate.NotAfter)
                            <span class="detail-list__note">@certificate.DaysRemaining days remaining</span>
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "link")</span>
                            <span>Hostname</span>
                        </span>
                        <span class="detail-list__value">@(certificate.HostnameMatched ? "Matches" : "Does not match")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "shield")</span>
                            <span>Chain</span>
                        </span>
                        <span class="detail-list__value">@(certificate.ChainTrusted ? "Trusted" : "Not trusted")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "key")</span>
                            <span>Fingerprint (SHA-256)</span>
                        </span>
                        <span class="detail-list__value target-url">@certificate.Sha256Fingerprint</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "eye")</span>
                            <span>Observed</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(certificate.ObservedAt)</span>
                    </div>
                </li>
            </ul>
        </div>
    }
</section>

<section class="card" aria-labelledby="endpoint-latest-heading">
    <div class="page-intro">
        <div>
            <h2 class="card__title" id="endpoint-latest-heading">Latest check</h2>
            @{ var latestStatus = latest is null ? "warning" : StatusBadges.ForOutcome(latest.Outcome); }
            <p class="card__status" data-status="@latestStatus">
                @await Html.PartialAsync("_Icon", StatusIcon(latestStatus))
                <span>Outcome &middot; @(latest is null ? "No checks yet" : latest.Outcome ?? latest.State)</span>
            </p>
        </div>

        @if (latest is not null)
        {
            <div class="form-actions">
                <a class="button button--secondary"
                   asp-controller="Checks"
                   asp-action="Check"
                   asp-route-id="@latest.LogicalCheckId">
                    @await Html.PartialAsync("_Icon", "clock")
                    <span>View details</span>
                </a>
            </div>
        }
    </div>

    @if (latest is null)
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
            "No checks yet",
            "Use Run above, or wait for the next scheduled run.",
            "clock"))
    }
    else
    {
        <div class="detail-list">
            <div class="detail-list__head" aria-hidden="true">
                <span>Subject</span>
                <span>Status</span>
            </div>
            <ul class="detail-list__items">
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "activity")</span>
                            <span>Outcome</span>
                        </span>
                        <span class="detail-list__value">
                            @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                StatusBadges.ForOutcome(latest.Outcome), latest.Outcome ?? latest.State))
                            @if (latest.FailureCategory is not null)
                            {
                                <span class="detail-list__note">@latest.FailureCategory</span>
                            }
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                            <span>Time</span>
                        </span>
                        <span class="detail-list__value">
                            @Html.TimestampWithSeconds((latest.CompletedAt ?? latest.ScheduledFor ?? latest.RequestedAt), "—")
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "play")</span>
                            <span>Source</span>
                        </span>
                        <span class="detail-list__value">
                            <span>@latest.Source</span>
                            @if (latest.InitiatedByDisplayName is not null)
                            {
                                <span class="detail-list__note">@latest.InitiatedByDisplayName</span>
                            }
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "diagnostics")</span>
                            <span>HTTP status</span>
                        </span>
                        <span class="detail-list__value">@(latest.HttpStatus?.ToString() ?? "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "speed")</span>
                            <span>Duration</span>
                        </span>
                        <span class="detail-list__value">@(latest.TotalDurationMs is { } duration ? $"{duration} ms" : "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "reports")</span>
                            <span>Uptime</span>
                        </span>
                        <span class="detail-list__value">@(latest.CountsForUptime ? "Counts" : "Excluded")</span>
                    </div>
                </li>
            </ul>
        </div>
    }
</section>

@section Scripts {
    @if (Model.LatestCheck is not null && Model.LatestCheck.State != WebHealth.Domain.Monitoring.LogicalCheckStates.Completed)
    {
        <script>setTimeout(function () { window.location.reload(); }, 4000);</script>
    }
}
