@model EndpointDetailsViewModel
@{ViewData.SetTitle("Endpoint"); ViewData.SetBreadcrumbs(new BreadcrumbItem("Registry"), new BreadcrumbItem(Model.Endpoint.WebsiteName), new BreadcrumbItem(Model.Endpoint.EnvironmentName), new BreadcrumbItem("Endpoint"));}
<section class="card"><div class="page-intro"><div><h2 class="card__title target-url">@Model.Endpoint.DisplayUrl</h2><p class="card__subtitle">@Model.Endpoint.WebsiteName / @Model.Endpoint.EnvironmentName · Version @Model.Endpoint.Version</p></div>@if(Model.CanManage && !Model.Endpoint.IsDeleted)
{
    <a class="button button--primary" asp-action="EditEndpoint" asp-route-id="@Model.Endpoint.Id">
        @await Html.PartialAsync("_Icon", "pencil")
        <span>Edit endpoint</span>
    </a>
}</div>
<dl class="registry-facts"><div><dt>Status</dt><dd><span class="badge" data-status="@(Model.Endpoint.IsDeleted ? "danger" : Model.Endpoint.IsEnabled ? "success" : "warning")">@(Model.Endpoint.IsDeleted ? "Deleted" : Model.Endpoint.IsEnabled ? "Enabled" : "Disabled")</span></dd></div><div><dt>Owner</dt><dd>@Model.Endpoint.OwnerName @(Model.Endpoint.InheritsWebsiteOwner ? "(website inherited)" : "")</dd></div><div><dt>Monitor configuration</dt><dd>@Model.Endpoint.MonitorType · every @(Model.Endpoint.IntervalSeconds / 60) min @(Model.Endpoint.IntervalMinutesOverride is null ? "(environment default)" : "(endpoint override)") · @(Model.Endpoint.TimeoutSeconds)s timeout · @(Model.Endpoint.MonitorEnabled ? "enabled" : "disabled")</dd></div><div><dt>Effective monitoring</dt><dd>@(Model.Endpoint.IsMonitoringEligible ? "Eligible" : "Not eligible")</dd></div><div><dt>Testing authorization</dt><dd>@(Model.Endpoint.CanTest ? "Authorized" : "Not authorized")</dd></div><div><dt>Target evidence</dt><dd>@(Model.CanManage ? Model.Endpoint.TargetAuthorizationEvidence ?? "Not recorded" : Model.Endpoint.HasTargetAuthorization ? "Recorded" : "Not recorded")</dd></div><div><dt>Canonical URL v@Model.Endpoint.NormalizationVersion</dt><dd class="target-url">@Model.Endpoint.NormalizedUrl</dd></div><div><dt>Production HTTP exception</dt><dd>@(Model.CanManage ? Model.Endpoint.HttpExceptionReason ?? "Not required" : Model.Endpoint.HasHttpException ? "Recorded" : "Not required")</dd></div></dl>
@if(Model.CanManage){<div class="registry-lifecycle">@if(Model.Endpoint.IsDeleted){<form asp-action="RestoreEndpoint" method="post"><input type="hidden" name="id" value="@Model.Endpoint.Id"/><input type="hidden" name="version" value="@Model.Endpoint.Version"/><button class="button button--primary">Restore endpoint</button></form>}else{@if(Model.Endpoint.IsEnabled){<form asp-action="DisableEndpoint" method="post"><input type="hidden" name="id" value="@Model.Endpoint.Id"/><input type="hidden" name="version" value="@Model.Endpoint.Version"/><button class="button button--secondary">Disable</button></form>}<form asp-action="DeleteEndpoint" method="post"><input type="hidden" name="id" value="@Model.Endpoint.Id"/><input type="hidden" name="version" value="@Model.Endpoint.Version"/><button class="button button--danger">Archive endpoint</button></form>}</div>}</section>
