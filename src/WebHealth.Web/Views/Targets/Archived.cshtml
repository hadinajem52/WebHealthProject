@model TargetArchiveViewModel
@{ViewData.SetTitle("Archived targets"); ViewData.SetBreadcrumbs(new BreadcrumbItem("Registry"), new BreadcrumbItem("Archived targets"));}
<section class="card"><div class="page-intro"><div><h2 class="card__title">Archived environments</h2><p class="card__subtitle">Manager-only restore workspace.</p></div><a class="button button--secondary" asp-controller="Registry" asp-action="Clients">Active registry</a></div>@if(Model.Environments.Count==0){<p class="card__subtitle">No archived environments.</p>}else{<div class="table-scroll"><table class="data-table"><thead><tr><th>Environment</th><th>Website</th><th>Type</th><th></th></tr></thead><tbody>@foreach(var environment in Model.Environments){<tr><td>@environment.Name</td><td>@environment.WebsiteName</td><td>@environment.EnvironmentType</td><td class="data-table__action"><a asp-action="Environment" asp-route-id="@environment.Id">Review</a></td></tr>}</tbody></table></div>}</section>
<section class="card"><h2 class="card__title">Archived endpoints</h2>@if(Model.Endpoints.Count==0){<p class="card__subtitle">No archived endpoints.</p>}else{<div class="table-scroll"><table class="data-table"><thead><tr><th>URL</th><th>Environment</th><th>Website</th><th></th></tr></thead><tbody>@foreach(var endpoint in Model.Endpoints){<tr><td class="target-url">@endpoint.DisplayUrl</td><td>@endpoint.EnvironmentName</td><td>@endpoint.WebsiteName</td><td class="data-table__action"><a asp-action="Endpoint" asp-route-id="@endpoint.Id">Review</a></td></tr>}</tbody></table></div>}</section>
