@model EndpointFormViewModel
@{
    ViewData.SetTitle("Edit endpoint");
    ViewData.SetBreadcrumbs(
        Breadcrumbs.Registry(Url),
        Breadcrumbs.Websites(Url),
        Breadcrumbs.Website(Url, Model.WebsiteId, Model.WebsiteName),
        Breadcrumbs.Environments(Url, Model.WebsiteId),
        Breadcrumbs.Environment(Url, Model.EnvironmentId, Model.EnvironmentName),
        Breadcrumbs.Endpoint(Url, Model.EndpointId, Model.Url),
        new BreadcrumbItem("Edit endpoint"));
}

@* No card title: the page heading already reads "Edit endpoint", and repeating it costs a line
   the reader has to skip past to reach the first field. *@
<section class="card form-card" aria-labelledby="edit-endpoint-label">
    @* Names the endpoint being edited. "The original version protects concurrent configuration
       changes" was the whole subtitle: an implementation note, in the one place that should say
       which record is about to change. *@
    <p class="card__subtitle" id="edit-endpoint-label">
        Changing <span class="target-url">@Model.Url</span> in
        <strong>@Model.WebsiteName / @Model.EnvironmentName</strong>. If someone else saves this
        endpoint first, your changes are refused rather than silently overwriting theirs.
    </p>

    <form asp-action="EditEndpoint" method="post" class="form-stack" id="ajax-form-region" data-ajax-region data-ajax-form data-ajax-target="#ajax-form-region">
        <partial name="_AjaxValidationSummary" />
        <input asp-for="EndpointId" type="hidden" />
        <input asp-for="EnvironmentId" type="hidden" />
        <input asp-for="Version" type="hidden" />
        <partial name="_EndpointForm" model="Model" />

        <div class="form-actions form-actions--spaced">
            <button class="button button--primary" type="submit">
                @await Html.PartialAsync("_Icon", "check")
                <span>Save endpoint</span>
            </button>
            <a class="button button--secondary" asp-action="Endpoint" asp-route-id="@Model.EndpointId">
                @await Html.PartialAsync("_Icon", "close")
                <span>Cancel</span>
            </a>
        </div>
    </form>
</section>
