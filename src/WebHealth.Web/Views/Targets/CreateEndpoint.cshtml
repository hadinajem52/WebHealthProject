@model EndpointFormViewModel
@{
    ViewData.SetTitle("Add endpoint");
    ViewData.SetBreadcrumbs(
        Breadcrumbs.Registry(Url),
        Breadcrumbs.Websites(Url),
        Breadcrumbs.Website(Url, Model.WebsiteId, Model.WebsiteName),
        Breadcrumbs.Environments(Url, Model.WebsiteId),
        Breadcrumbs.Environment(Url, Model.EnvironmentId, Model.EnvironmentName),
        new BreadcrumbItem("Add endpoint"));
}


<section class="card form-card" aria-labelledby="create-endpoint-label">
    
    <p class="card__subtitle" id="create-endpoint-label">
        Adds an endpoint to <strong>@Model.WebsiteName / @Model.EnvironmentName</strong> and
        creates its HTTP availability policy. To create it enabled, enter the URL and record
        permission to test the target. The remaining settings have working defaults you can change later.
    </p>

    <form asp-action="CreateEndpoint" method="post" class="form-stack" id="ajax-form-region" data-ajax-region data-ajax-form data-ajax-target="#ajax-form-region">
        <partial name="_AjaxValidationSummary" />
        <input asp-for="EnvironmentId" type="hidden" />
        <partial name="_EndpointForm" model="Model" />

        <div class="form-actions form-actions--spaced">
            <button class="button button--primary" type="submit">
                @await Html.PartialAsync("_Icon", "plus")
                <span>Create endpoint</span>
            </button>
            <a class="button button--secondary" asp-action="Environment" asp-route-id="@Model.EnvironmentId">
                @await Html.PartialAsync("_Icon", "close")
                <span>Cancel</span>
            </a>
        </div>
    </form>
</section>
