@model PageAuditIndexViewModel
@using WebHealth.Domain.PageAudits
@{
    ViewData.SetTitle("PageSpeed");
    ViewData.SetBreadcrumbs(new BreadcrumbItem("PageSpeed"));
    var summary = Model.Summary;
    var run = summary?.LatestRun;
    var comparison = summary?.Comparison;
    var selectedLabel = Model.Endpoints
        .FirstOrDefault(candidate => candidate.Id == Model.SelectedEndpointId)?.Label;
    var strategyLabel = PageAuditDisplay.DescribeStrategy(Model.SelectedStrategy);
    var categoryLabel = PageAuditDisplay.DescribeCategory(Model.SelectedCategory);
    var auditStatusUrl = run?.IsActive == true
        ? Url.Action("Status", "PageAudits", new
        {
            endpointId = Model.SelectedEndpointId,
            category = Model.SelectedCategory,
            strategy = Model.SelectedStrategy,
            runId = run.RunId
        })
        : null;

    static string StatusIcon(string tone) => tone switch
    {
        "success" => "success",
        "danger" => "error",
        "warning" => "warning",
        "info" => "information",
        _ => "clock"
    };
}

<div id="ajax-page"
     class="stack"
     data-ajax-region
     data-run-scope="#page-audit-results">
    
    <section class="card" aria-labelledby="pagespeed-scope-label">
        <p class="card__subtitle" id="pagespeed-scope-label">
            Google PageSpeed Insights runs Lighthouse against a public page and returns a
            scores for performance, accessibility, best practices, and SEO, with the Lighthouse
            metrics and audits behind each score.
        </p>

        <div class="filter-inline filter-inline--wide">
            <form method="get" class="filter-inline__group" data-ajax-form data-ajax-target="#ajax-page" data-ajax-history="push" data-page-audits-selection>
                
                <input type="hidden" name="strategy" value="@Model.SelectedStrategy" />
                <input type="hidden" name="category" value="@Model.SelectedCategory" />
                <div class="form-field">
                    <label for="endpointId">Endpoint</label>
                    <select id="endpointId" name="endpointId">
                        <option value="">Select an endpoint</option>
                        @foreach (var option in Model.Endpoints)
                        {
                            <option value="@option.Id" title="@option.FullLabel" selected="@(option.Id == Model.SelectedEndpointId)">@option.Label</option>
                        }
                    </select>
                </div>
                <button class="button button--primary" type="submit">
                    @await Html.PartialAsync("_Icon", "search")
                    <span>Show audits</span>
                </button>
            </form>

            
            @if (Model.SelectedEndpointId is { } runTarget
                && Model.CanRunNow
                && Model.Endpoints.Any(option => option.Id == runTarget))
            {
                <form method="post" asp-action="RunNow" data-ajax-form data-ajax-target="#ajax-page">
                    <input type="hidden" name="endpointId" value="@runTarget" />
                    <input type="hidden" name="category" value="@Model.SelectedCategory" />
                    <input type="hidden" name="strategy" value="@Model.SelectedStrategy" />
                    <button class="button button--secondary" type="submit"
                            title="Asks Google to audit this page on mobile and desktop now. The scores appear once Google answers.">
                        @await Html.PartialAsync("_Icon", "play")
                        <span>Run now</span>
                    </button>
                </form>
            }

            @if (User.IsInRole("Administrator")
                && Model.SelectedEndpointId is { } settingsTarget
                && summary?.IsConfigured == true
                && Model.Endpoints.Any(option => option.Id == settingsTarget))
            {
                <a class="button button--secondary button--icon"
                   asp-controller="PageAuditSettings"
                   asp-action="Index"
                   asp-route-endpointId="@settingsTarget"
                   title="Incident settings for @selectedLabel"
                   aria-label="Incident settings for @selectedLabel">
                    @await Html.PartialAsync("_Icon", "settings")
                </a>
            }
        </div>

        
        @if (Model.SelectedEndpointId is { } blockedTarget
            && !Model.CanRunNow
            && summary?.IsEnabled == true
            && EndpointTestBlockDisplay.Describe(Model.RunBlock, "an audit") is { } blockedReason)
        {
            <p class="card__status" data-status="warning">
                @await Html.PartialAsync("_Icon", "warning")
                <span>
                    @blockedReason
                    @if (Model.Endpoints.Any(option => option.Id == blockedTarget))
                    {
                        <a asp-controller="Targets" asp-action="Endpoint" asp-route-id="@blockedTarget">Open endpoint</a>
                    }
                </span>
            </p>
        }

        @if (Model.SelectedEndpointId is not null)
        {
            
            <nav class="segmented" aria-label="Form factor">
                @foreach (var strategy in PageAuditStrategies.All)
                {
                    var isSelected = strategy == Model.SelectedStrategy;
                    <a class="segmented__option"
                       aria-current="@(isSelected ? "page" : null)"
                       asp-action="Index"
                       data-ajax-link
                       data-ajax-target="#ajax-page"
                       asp-route-endpointId="@Model.SelectedEndpointId"
                       asp-route-category="@Model.SelectedCategory"
                       asp-route-strategy="@strategy">
                        @PageAuditDisplay.DescribeStrategy(strategy)
                    </a>
                }
            </nav>
        }
    </section>

    <div id="page-audit-results"
         class="stack"
         data-run-status
         data-run-active="@(Model.AnyCategoryRunActive ? "true" : "false")"
         data-run-url="@auditStatusUrl">
    @if (summary is null)
    {
        <section class="card">
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "Select an endpoint",
                "PageSpeed audits are configured and recorded per endpoint. Choose one to see its score.",
                "reports"))
        </section>
    }
    else if (!summary.IsConfigured || !summary.IsEnabled)
    {
        <section class="card">
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "PageSpeed auditing is off for this endpoint",
                "Enable it on the endpoint to have Google audit this page on mobile and desktop. Enabling sends the URL to Google and asks Google infrastructure to load it, so it is only suitable for public pages.",
                "reports"))
        </section>
    }

    @if (summary is not null && summary.IsConfigured && summary.IsEnabled)
    {
        var summaryTone = run is null ? "neutral" : PageAuditDisplay.StatusTone(run);

        <nav class="pagespeed-score-grid" aria-label="Lighthouse categories">
            @foreach (var categorySummary in Model.CategorySummaries)
            {
                var categoryRun = categorySummary.LatestRun;
                var categoryName = PageAuditDisplay.DescribeCategory(categorySummary.Category);
                var categoryTone = categoryRun?.HasScore == true
                    ? PageAuditDisplay.ScoreTone(categoryRun.Score)
                    : categoryRun?.IsActive == true ? "info" : "neutral";
                var isSelected = categorySummary.Category == Model.SelectedCategory;
                <a class="pagespeed-score"
                   data-status="@categoryTone"
                   aria-current="@(isSelected ? "page" : null)"
                   asp-action="Index"
                   data-ajax-link
                   data-ajax-target="#ajax-page"
                   asp-route-endpointId="@Model.SelectedEndpointId"
                   asp-route-category="@categorySummary.Category"
                   asp-route-strategy="@Model.SelectedStrategy">
                    <span class="pagespeed-score__ring">
                        @if (categoryRun?.HasScore == true)
                        {
                            <span>@categoryRun.Score</span>
                        }
                        else if (categoryRun?.IsActive == true)
                        {
                            @await Html.PartialAsync("_Spinner", $"page-audit-category-{categoryRun.RunId}")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </span>
                    <span class="pagespeed-score__label">@categoryName</span>
                </a>
            }
        </nav>

        <section class="card">
            <div class="page-intro">
                <div>
                    <h3 class="card__title target-url">@(selectedLabel ?? "Selected endpoint")</h3>
                    <p class="card__status" data-status="@summaryTone">
                        @if (run?.IsActive == true)
                        {
                            @await Html.PartialAsync("_Spinner", $"page-audit-summary-{run.RunId}")
                        }
                        else
                        {
                            @await Html.PartialAsync("_Icon", StatusIcon(summaryTone))
                        }
                        <span>@categoryLabel &middot; @strategyLabel &middot; @(run is null ? "No audit has run yet" : PageAuditDisplay.DescribeStatus(run))</span>
                    </p>
                </div>
            </div>

            <div class="detail-list">
                <div class="detail-list__head" aria-hidden="true">
                    <span>Subject</span>
                    <span>Status</span>
                </div>
                <ul class="detail-list__items">
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "speed")</span>
                                <span>@categoryLabel score</span>
                            </span>
                            <span class="detail-list__value">
                                @if (run is not null && run.HasScore)
                                {
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(PageAuditDisplay.ScoreTone(run.Score), $"{run.Score} / 100"))
                                }
                                else
                                {
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel("neutral", "Not measured"))
                                }
                            </span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "activity")</span>
                                <span>Latest @strategyLabel.ToLowerInvariant() run</span>
                            </span>
                            <span class="detail-list__value">
                                @if (run is null)
                                {
                                    <span>No audit has run yet</span>
                                }
                                else
                                {
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                        PageAuditDisplay.StatusTone(run),
                                        PageAuditDisplay.DescribeStatus(run),
                                        null,
                                        run.IsActive,
                                        $"page-audit-latest-{run.RunId}"))
                                }
                            </span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                                <span>Scheduled</span>
                            </span>
                            <span class="detail-list__value">
                                @if (summary.SchedulingEnabled)
                                {
                                    <span>Every @summary.IntervalHours hours</span>
                                    @if (summary.NextDueAt is { } due)
                                    {
                                        <span class="detail-list__note">Next @Html.Timestamp(due)</span>
                                    }
                                }
                                else
                                {
                                    <span>On demand only</span>
                                }
                            </span>
                        </div>
                    </li>
                    @if (run?.AnalysisAt is { } analysedAt)
                    {
                        <li>
                            <div class="detail-list__row">
                                <span class="detail-list__subject">
                                    <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "calendar")</span>
                                    <span>Audited</span>
                                </span>
                                <span class="detail-list__value">@Html.Timestamp(analysedAt)</span>
                            </div>
                        </li>
                    }
                    @if (run?.LighthouseVersion is { } version)
                    {
                        <li>
                            <div class="detail-list__row">
                                <span class="detail-list__subject">
                                    <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "information")</span>
                                    <span>Lighthouse version</span>
                                </span>
                                <span class="detail-list__value">@version</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    @if (summary is not null && run is not null)
    {
        @if (run.IsActive)
        {
            <section class="card">
                <div class="page-intro">
                    <div>
                        <h3 class="card__title">Audit in progress</h3>
                        <p class="card__status" data-status="info">
                            @await Html.PartialAsync("_Icon", "clock")
                            <span>Google is running this audit@(run.AttemptCount > 1 ? $" · attempt {run.AttemptCount}" : null)</span>
                        </p>
                    </div>
                    <div class="form-actions">
                        <a class="button button--secondary"
                           asp-action="Index"
                           asp-route-endpointId="@Model.SelectedEndpointId"
                           asp-route-category="@Model.SelectedCategory"
                           asp-route-strategy="@Model.SelectedStrategy"
                           asp-route-runId="@run.RunId"
                           data-ajax-link
                           data-ajax-target="#page-audit-results"
                           data-ajax-history="replace">Refresh status</a>
                    </div>
                </div>
                <p class="card__subtitle">This page refreshes the audit status while it is active.</p>
            </section>
        }

        @if (run.Status == PageAuditRunStatuses.Failed)
        {
            <section class="card">
                <div class="page-intro">
                    <div>
                        <h3 class="card__title">This audit produced no score</h3>
                        <p class="card__status" data-status="danger">
                            @await Html.PartialAsync("_Icon", "error")
                            <span>@PageAuditDisplay.DescribeFailure(run.FailureCategory)</span>
                        </p>
                    </div>
                </div>
                @if (run.SafeDiagnostic is { } diagnostic)
                {
                    <p class="card__subtitle">@diagnostic</p>
                }
                <p class="card__subtitle">
                    A failed audit is not a finding about the page. Nothing here changes the last
                    score that was measured.
                </p>
            </section>
        }

        @if (run.HasScore && comparison is not null)
        {
            <section class="card">
                <div class="page-intro">
                    <div>
                        <h3 class="card__title">Change since the previous audit</h3>
                        <p class="card__status" data-status="neutral">
                            @await Html.PartialAsync("_Icon", "reports")
                            <span>@PageAuditDisplay.DescribeComparison(comparison)</span>
                        </p>
                    </div>
                </div>
                @if (comparison.PreviousRunId is not null)
                {
                    <div class="detail-list">
                        <div class="detail-list__head" aria-hidden="true">
                            <span>Subject</span>
                            <span>Status</span>
                        </div>
                        <ul class="detail-list__items">
                            <li>
                                <div class="detail-list__row">
                                    <span class="detail-list__subject">
                                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "activity")</span>
                                        <span>Current</span>
                                    </span>
                                    <span class="detail-list__value">@comparison.CurrentScore</span>
                                </div>
                            </li>
                            <li>
                                <div class="detail-list__row">
                                    <span class="detail-list__subject">
                                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "restore")</span>
                                        <span>Previous</span>
                                    </span>
                                    <span class="detail-list__value">@comparison.PreviousScore</span>
                                </div>
                            </li>
                            <li>
                                <div class="detail-list__row">
                                    <span class="detail-list__subject">
                                        <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "speed")</span>
                                        <span>Change</span>
                                    </span>
                                    <span class="detail-list__value">@(comparison.Delta > 0 ? "+" : null)@comparison.Delta</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                }
            </section>
        }

        @if (run.WarningSummary is { } warnings)
        {
            <section class="card">
                <div class="page-intro">
                    <div>
                        <h3 class="card__title">Provider warnings</h3>
                        <p class="card__status" data-status="warning">
                            @await Html.PartialAsync("_Icon", "warning")
                            <span>Reported by Google while running the audit &middot; the score is still usable</span>
                        </p>
                    </div>
                </div>
                <p>@warnings</p>
            </section>
        }

        @if (run.RedirectedTo is { } finalUrl)
        {
            <section class="card">
                <div class="page-intro">
                    <div>
                        <h3 class="card__title">Google audited a different URL</h3>
                        <p class="card__status" data-status="warning">
                            @await Html.PartialAsync("_Icon", "link")
                            <span>The score describes the page the redirect landed on</span>
                        </p>
                    </div>
                </div>
                <div class="detail-list">
                    <div class="detail-list__head" aria-hidden="true">
                        <span>Subject</span>
                        <span>Status</span>
                    </div>
                    <ul class="detail-list__items">
                        <li>
                            <div class="detail-list__row">
                                <span class="detail-list__subject">
                                    <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "arrow-right")</span>
                                    <span>Requested</span>
                                </span>
                                <span class="detail-list__value target-url">@run.RequestedUrl</span>
                            </div>
                        </li>
                        <li>
                            <div class="detail-list__row">
                                <span class="detail-list__subject">
                                    <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "link")</span>
                                    <span>Audited</span>
                                </span>
                                <span class="detail-list__value target-url">@finalUrl</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </section>
        }

        <section class="card">
            <div class="page-intro">
                <div>
                    <h3 class="card__title">@categoryLabel metrics and audits</h3>
                    <p class="card__status" data-status="@(summary.Counts.Failed > 0 ? "danger" : "success")">
                        @await Html.PartialAsync("_Icon", summary.Counts.Failed > 0 ? "error" : "success")
                        <span>@summary.Counts.Failed failed &middot; @summary.Counts.Passed passed</span>
                    </p>
                </div>
            </div>

            <p class="card__subtitle">
                Manual and not-applicable audits are listed apart from passed ones: neither is
                a check this page passed, and neither counts against the score.
            </p>

            @if (Model.PerformanceMetrics.Count > 0)
            {
                <div class="pagespeed-metrics" aria-label="Performance metrics">
                    @foreach (var metric in Model.PerformanceMetrics)
                    {
                        <article class="pagespeed-metric" data-status="@PageAuditDisplay.MetricTone(metric)">
                            <span class="pagespeed-metric__indicator" aria-hidden="true"></span>
                            <span class="pagespeed-metric__label">@PageAuditDisplay.MetricLabel(metric.AuditId)</span>
                            <strong class="pagespeed-metric__value">@PageAuditDisplay.FormatMetric(metric)</strong>
                        </article>
                    }
                </div>
            }

            <div class="detail-list">
                <div class="detail-list__head" aria-hidden="true">
                    <span>Subject</span>
                    <span>Status</span>
                </div>
                <ul class="detail-list__items">
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "error")</span>
                                <span>Failed</span>
                            </span>
                            <span class="detail-list__value">@summary.Counts.Failed</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "success")</span>
                                <span>Passed</span>
                            </span>
                            <span class="detail-list__value">@summary.Counts.Passed</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "person")</span>
                                <span>Manual</span>
                            </span>
                            <span class="detail-list__value">@summary.Counts.Manual</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "close")</span>
                                <span>Not applicable</span>
                            </span>
                            <span class="detail-list__value">@summary.Counts.NotApplicable</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "information")</span>
                                <span>Informative</span>
                            </span>
                            <span class="detail-list__value">@summary.Counts.Informative</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "warning")</span>
                                <span>Errors</span>
                            </span>
                            <span class="detail-list__value">@summary.Counts.Error</span>
                        </div>
                    </li>
                </ul>
            </div>

            @foreach (var auditGroup in Model.Sections.Where(candidate => candidate.Items.Count > 0))
            {
                <details class="disclosure" open="@(auditGroup.Status == PageAuditItemStatuses.Failed)">
                    <summary class="disclosure__summary">
                        <span class="disclosure__chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                        <span class="disclosure__title">@auditGroup.Title</span>
                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                            PageAuditDisplay.ItemTone(auditGroup.Status),
                            auditGroup.Items.Count.ToString(),
                            $"{auditGroup.Items.Count} {auditGroup.Title.ToLowerInvariant()}"))
                    </summary>
                    <div class="disclosure__body">
                        <p class="disclosure__description">@auditGroup.Description</p>
                        <ul class="audit-list">
                            @foreach (var item in auditGroup.Items)
                            {
                                <li>
                                    <div class="audit-list__row">
                                        <div>
                                            <p class="audit-list__title">@Html.LighthouseText(item.Title ?? item.AuditId)</p>
                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <p class="audit-list__description">@Html.LighthouseText(item.Description)</p>
                                            }
                                        </div>
                                        <div class="audit-list__value">
                                            @if (item.DisplayValue is null && item.Explanation is null
                                                 && !string.IsNullOrWhiteSpace(item.ErrorMessage))
                                            {
                                                <span class="audit-list__source">Google reported:</span>
                                            }
                                            @Html.LighthouseText(item.DisplayValue ?? item.Explanation ?? item.ErrorMessage, "—")
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </details>
            }
        </section>
    }

    @if (Model.Runs.Count > 0)
    {
        <section class="card">
            <div class="page-intro">
                <div>
                    <h3 class="card__title">Run history</h3>
                    <p class="card__status" data-status="neutral">
                        @await Html.PartialAsync("_Icon", "clock")
                        <span>@Model.Runs.Count @strategyLabel.ToLowerInvariant() run@(Model.Runs.Count == 1 ? null : "s") &middot; select one to see the audits it recorded</span>
                    </p>
                </div>
                @await Html.PartialAsync("_ClearHistoryAction", new ClearHistoryActionViewModel(
                    Url.Action("ClearHistory", new { endpointId = Model.SelectedEndpointId, category = Model.SelectedCategory, strategy = Model.SelectedStrategy })!,
                    Url.Action("Archived", new { endpointId = Model.SelectedEndpointId, category = Model.SelectedCategory, strategy = Model.SelectedStrategy })!,
                    Model.CanArchive,
                    Model.Runs.Any(run => !run.IsActive),
                    $"Moves every finished {strategyLabel.ToLowerInvariant()} {categoryLabel.ToLowerInvariant()} run for this endpoint out of this list into the archive. Nothing is deleted, and each run can be restored.",
                    $"Move every finished {strategyLabel.ToLowerInvariant()} {categoryLabel.ToLowerInvariant()} run for this endpoint to the archive?",
                    "#ajax-page"))
            </div>
            <div class="table-scroll table-scroll--flush">
                <table class="data-table data-table--history">
                    <caption class="visually-hidden">@strategyLabel @categoryLabel PageSpeed runs for the selected endpoint</caption>
                    <thead>
                        <tr>
                            <th scope="col">Subject</th>
                            <th scope="col">Status</th>
                            <th scope="col">Score</th>
                            <th scope="col">Lighthouse</th>
                            <th scope="col"><span class="visually-hidden">Details</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var historyRun in Model.Runs)
                        {
                            <tr>
                                <td data-label="Subject">
                                    <span class="history-cell">
                                        @await Html.PartialAsync("_HistoryMark", PageAuditDisplay.StatusTone(historyRun))
                                        <span class="history-cell__subject">@historyRun.Source run</span>
                                        <span class="history-cell__time">@Html.Timestamp(historyRun.QueuedAt)</span>
                                    </span>
                                </td>
                                <td data-label="Status">
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                        PageAuditDisplay.StatusTone(historyRun),
                                        PageAuditDisplay.DescribeStatus(historyRun),
                                        null,
                                        historyRun.IsActive,
                                        $"page-audit-history-{historyRun.RunId}"))
                                </td>
                                <td data-label="Score">
                                    @if (historyRun.HasScore)
                                    {
                                        <span class="badge" data-status="@PageAuditDisplay.ScoreTone(historyRun.Score)">@historyRun.Score</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td data-label="Lighthouse">@(historyRun.LighthouseVersion ?? "—")</td>
                                <td class="data-table__action" data-label="Details">
                                    <a asp-action="Index"
                                       data-ajax-link
                                       data-ajax-target="#ajax-page"
                                       asp-route-endpointId="@Model.SelectedEndpointId"
                                       asp-route-category="@Model.SelectedCategory"
                                       asp-route-strategy="@Model.SelectedStrategy"
                                       asp-route-runId="@historyRun.RunId">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    </div>
</div>

@section Scripts {
    <script src="~/js/poller.js" asp-append-version="true"></script>
    <script src="~/js/run-status.js" asp-append-version="true"></script>
}
