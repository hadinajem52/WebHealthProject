@{
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var currentAction = ViewContext.RouteData.Values["action"] as string;
    var groupIndex = 0;
}
<nav id="app-sidebar" class="app-sidebar" aria-label="Primary" data-shell-sidebar data-open="false">
    <div class="app-sidebar__head">
        <a class="app-brand" asp-controller="Home" asp-action="Index">
            <span class="app-brand__mark">@await Html.PartialAsync("_Icon", "brand")</span>
            <span class="app-brand__name">WebHealth</span>
        </a>

        <button type="button"
                class="app-sidebar__collapse"
                data-shell-collapse
                aria-controls="app-sidebar"
                aria-expanded="true"
                aria-label="Close sidebar">
            @await Html.PartialAsync("_Icon", "sidebar")
            <span class="app-tip" aria-hidden="true" data-shell-collapse-tip>Close sidebar</span>
        </button>
    </div>

    <button type="button" class="app-sidebar__close" data-shell-close>
        @await Html.PartialAsync("_Icon", "close")
        <span>Close menu</span>
    </button>

    <hr class="app-sidebar__divider" />

    @foreach (var navSection in ShellNavigation.Sections)
    {
        var visibleItems = navSection.Items.Where(item => item.IsVisible(User)).ToArray();
        if (visibleItems.Length == 0)
        {
            continue;
        }
        groupIndex++;
        var headingId = $"app-nav-group-{groupIndex}";
        <div class="app-nav__group">
            @if (navSection.Heading is not null)
            {
                <p class="app-nav__heading" id="@headingId">@navSection.Heading</p>
            }
            <ul class="app-nav__list" aria-labelledby="@(navSection.Heading is null ? null : headingId)">
                @foreach (var item in visibleItems)
                {
                    <li>
                        @if (item.IsAvailable)
                        {
                            var isCurrent = item.IsCurrent(currentController, currentAction);
                            <a class="app-nav__link @(isCurrent ? "is-current" : null)"
                               asp-controller="@item.Controller"
                               asp-action="@item.Action"
                               aria-current="@(isCurrent ? "page" : null)">
                                <span class="app-nav__icon">@await Html.PartialAsync("_Icon", item.IconKey)</span>
                                <span class="app-nav__label">@item.Text</span>
                                <span class="app-nav__tooltip" aria-hidden="true">@item.Text</span>
                            </a>
                        }
                        else
                        {
                            <span class="app-nav__link is-planned" aria-disabled="true">
                                <span class="app-nav__icon">@await Html.PartialAsync("_Icon", item.IconKey)</span>
                                <span class="app-nav__label">@item.Text</span>
                                <span class="app-nav__tooltip" aria-hidden="true">@item.Text</span>
                                <span class="app-nav__badge">Planned</span>
                            </span>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <div class="app-sidebar__support">
        <span class="app-sidebar__support-icon">@await Html.PartialAsync("_Icon", "diagnostics")</span>
        <p class="app-sidebar__support-title"><span class="app-sidebar__support-name">System status</span></p>
        <span class="app-sidebar__tooltip" aria-hidden="true">System status</span>
        <p class="app-sidebar__support-state">
            <span class="app-sidebar__support-dot" aria-hidden="true"></span>
            <span>Application responding</span>
        </p>
        <p class="app-sidebar__support-text">Signed in and served by this instance.</p>
        <a class="app-sidebar__support-link" href="/health/ready">Runtime readiness</a>
    </div>
</nav>
