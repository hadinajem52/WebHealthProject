@{
    var pageTitle = ViewData.GetTitle();
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle) ? "WebHealth" : $"{pageTitle} - WebHealth";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@documentTitle</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <script src="~/js/shell.js" asp-append-version="true"></script>
</head>
<body class="auth-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="auth-shell">
        <main id="main-content" class="auth-main" tabindex="-1">
            @RenderBody()
        </main>

        @* Decorative panel: the identity it carries is repeated in the form. *@
        <div class="auth-visual">
            <span class="auth-visual__brand">
                @await Html.PartialAsync("_Icon", "brand")
                <span>WebHealth</span>
            </span>
        </div>
    </div>

    <footer class="auth-footer">
        <p>Website Health Monitoring &mdash; internal monitoring workspace.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
