@model StatusBadgeViewModel


@{
    var pendingClass = Model.Pending ? " badge--pending" : null;
    var badgeClass = $"badge{pendingClass}";
    var detailedClass = $"badge badge--detailed{pendingClass}";
}
@if (string.IsNullOrWhiteSpace(Model.Detail))
{
    <span class="@badgeClass" data-status="@Model.Status">
        @if (Model.Pending)
        {
            <span class="spinner spinner--badge" aria-hidden="true" data-preserve-animation="@Model.AnimationKey"></span>
        }
        <span class="badge__label" data-live="@Model.LiveKey">@Model.Label</span>
    </span>
}
else
{
    <span class="@detailedClass"
          data-status="@Model.Status"
          data-badge-detail="@Model.Detail"
          title="@Model.Detail"
          tabindex="0">
        @if (Model.Pending)
        {
            <span class="spinner spinner--badge" aria-hidden="true" data-preserve-animation="@Model.AnimationKey"></span>
        }
        <span class="badge__label" data-live="@Model.LiveKey">@Model.Label</span>
        <span class="badge__info" aria-hidden="true">@await Html.PartialAsync("_Icon", "information")</span>
        <span class="visually-hidden">&mdash; @Model.Detail</span>
    </span>
}
