@model ErrorViewModel
@{
    ViewData.SetTitle(Model.Title);
    ViewData.SetBreadcrumbs(
        new BreadcrumbItem("Dashboard", Url.Action("Index", "Home")),
        new BreadcrumbItem(Model.Title));
}

<section class="error-state">
    <p class="error-state__status">
        @await Html.PartialAsync("_Icon", "error")
        <span>Error @Model.StatusCode</span>
    </p>
    <p class="error-state__message">@Model.Message</p>

    <dl class="data-list error-state__reference">
        <dt>Correlation reference</dt>
        <dd><code>@Model.CorrelationId</code></dd>
    </dl>

    <div class="error-state__actions">
        @if (Model.RetryUrl is not null)
        {
            <a class="button button--primary" href="@Model.RetryUrl">Try again</a>
        }
        <a class="button button--secondary" asp-controller="Home" asp-action="Index">
            <span>Return to the dashboard</span>
            @await Html.PartialAsync("_Icon", "arrow-right")
        </a>
    </div>
</section>
