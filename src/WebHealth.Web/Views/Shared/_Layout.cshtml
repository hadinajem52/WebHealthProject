@{
    var pageTitle = ViewData.GetTitle();
    var pageSubtitle = ViewData.GetSubtitle();
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle) ? "WebHealth" : $"{pageTitle} - WebHealth";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@documentTitle</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />

    <script src="~/js/shell.js" asp-append-version="true"></script>
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="app-shell">
    
        @await Html.PartialAsync("_Sidebar")

        <div class="app-column" data-shell-content>
            <header class="app-header">
                <div class="app-header__bar">
                    <button type="button"
                            class="app-header__toggle"
                            data-shell-toggle
                            aria-controls="app-sidebar"
                            aria-expanded="false">
                        @await Html.PartialAsync("_Icon", "menu")
                        <span>Menu</span>
                    </button>

                    <div class="app-header__titles">
                        @await Html.PartialAsync("_Breadcrumbs")
                        <h1 class="app-title">@(pageTitle ?? "WebHealth")</h1>
                        @if (pageSubtitle is not null)
                        {
                            <p class="app-subtitle">@pageSubtitle</p>
                        }
                    </div>

                    @*
                        The account, display-preference and notification controls. Each is a real
                        control with a real hit area; anything not yet implemented states that it
                        is planned rather than pretending to work.
                    *@
                    <div class="app-header__utility">
                        @*
                            The menu is rendered open in the document, so signing
                            out is reachable without script; the enhancement in
                            shell.js collapses it to a button-triggered popup.
                        *@
                        <div class="app-account" data-shell-account data-open="false">
                            <button type="button"
                                    class="app-header__account"
                                    data-shell-account-toggle
                                    aria-controls="app-account-menu"
                                    aria-expanded="false">
                                @await Html.PartialAsync("_Icon", "person")
                                <span>@User.GetDisplayName()</span>
                                <span class="visually-hidden">&mdash; account menu</span>
                            </button>

                            <div class="app-account__menu" id="app-account-menu" data-shell-account-menu>
                                <p class="app-account__identity">
                                    <span class="app-account__name">@User.GetDisplayName()</span>
                                    <span class="app-account__email">@User.Identity?.Name</span>
                                </p>

                                <button type="button" class="app-account__item is-planned" aria-disabled="true">
                                    @await Html.PartialAsync("_Icon", "settings")
                                    <span>Settings</span>
                                    <span class="app-account__badge">Planned</span>
                                </button>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="app-header__account-form">
                                    <button type="submit" class="app-account__item">
                                        @await Html.PartialAsync("_Icon", "sign-out")
                                        <span>Sign out</span>
                                    </button>
                                </form>
                            </div>
                        </div>

                        @*
                            Display preferences only. Nothing here is sent to the server or stored
                            against the account: the instants themselves stay UTC everywhere, and
                            the choice is which zone this browser renders them in.
                        *@
                        <div class="app-settings" data-shell-settings data-open="false">
                            <button type="button"
                                    class="app-header__icon"
                                    data-shell-settings-toggle
                                    aria-controls="app-settings-menu"
                                    aria-expanded="false">
                                @await Html.PartialAsync("_Icon", "settings")
                                <span class="visually-hidden">Settings</span>
                            </button>

                            <div class="app-settings__menu" id="app-settings-menu" data-shell-settings-menu>
                                <p class="app-settings__title">Display</p>

                                <fieldset class="app-settings__group">
                                    <legend class="app-settings__legend">Show times in</legend>

                                    <label class="app-settings__option">
                                        <input type="radio" name="shell-timezone" value="local"
                                               data-shell-timezone-option />
                                        <span class="app-settings__option-text">
                                            <span class="app-settings__option-name">Local time</span>
                                            <span class="app-settings__option-hint" data-shell-timezone-name>
                                                Your computer&rsquo;s time zone
                                            </span>
                                        </span>
                                    </label>

                                    <label class="app-settings__option">
                                        <input type="radio" name="shell-timezone" value="utc"
                                               data-shell-timezone-option />
                                        <span class="app-settings__option-text">
                                            <span class="app-settings__option-name">UTC</span>
                                            <span class="app-settings__option-hint">As stored and recorded</span>
                                        </span>
                                    </label>
                                </fieldset>

                                <p class="app-settings__note">
                                    Times are always stored in UTC. This only changes how they are shown here.
                                </p>
                            </div>
                        </div>

                        @await Component.InvokeAsync("NotificationsMenu")

                        @if (IsSectionDefined("PageActions"))
                        {
                            @await RenderSectionAsync("PageActions", required: false)
                        }
                    </div>
                </div>
            </header>

            <main id="main-content" class="app-content" tabindex="-1">
                @await Html.PartialAsync("_FlashMessages")
                @await Html.PartialAsync("_ValidationSummary")
                @RenderBody()
            </main>

            <footer class="app-footer">
                <p>Website Health Monitoring</p>
                <div class="app-footer__links">
                    <a href="/health/live">Liveness</a>
                    <a href="/health/ready">Readiness</a>
                </div>
            </footer>
        </div>
    </div>

    <div class="app-scrim" data-shell-scrim hidden></div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
