@model FilterSummaryViewModel
@*
    BR-R01. Rendered as a definition list rather than as prose so a screen reader can move
    term-by-term through the applied filters instead of hearing one long sentence.
*@
<div class="filter-summary" role="note" aria-label="Applied filters and data freshness">
    <dl class="filter-summary__list">
        @if (Model.Window is not null)
        {
            <div class="filter-summary__item">
                <dt>Window</dt>
                <dd>@Model.Window</dd>
            </div>
        }
        @if (Model.IsUnfiltered)
        {
            <div class="filter-summary__item">
                <dt>Filters</dt>
                <dd>None — everything you have access to</dd>
            </div>
        }
        else
        {
            @foreach (var filter in Model.Filters)
            {
                <div class="filter-summary__item">
                    <dt>@filter.Label</dt>
                    <dd>@filter.Value</dd>
                </div>
            }
        }
        <div class="filter-summary__item">
            <dt>As of</dt>
            <dd><time datetime="@Model.AsOf.UtcDateTime.ToString("O")">@Model.AsOf.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</time></dd>
        </div>
    </dl>
    @if (Model.Note is not null)
    {
        <p class="filter-summary__note">@Model.Note</p>
    }
</div>
