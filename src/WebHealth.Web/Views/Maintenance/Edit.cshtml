@model MaintenanceWindowFormViewModel
@{ ViewData.SetTitle("Edit maintenance"); ViewData.SetBreadcrumbs(new BreadcrumbItem("Maintenance", "/Maintenance"), new BreadcrumbItem("Edit")); }
<section class="card form-card"><h2 class="card__title">Edit maintenance</h2><p class="card__subtitle">Editing replaces this window with a new immutable occurrence; prior check evidence remains linked to the original.</p><form asp-action="Edit" method="post" class="form-stack"><input asp-for="MaintenanceWindowId" type="hidden" /><input asp-for="Version" type="hidden" /><partial name="_Form" model="Model" /><div class="form-actions"><button class="button button--primary" type="submit">Save replacement</button><a class="button button--secondary" asp-action="Details" asp-route-id="@Model.MaintenanceWindowId">Cancel</a></div></form></section>
