@model MaintenanceArchiveViewModel
@{
    ViewData.SetTitle("Maintenance archive");
    ViewData.SetBreadcrumbs(new BreadcrumbItem("Maintenance", Url.Action("Index", "Maintenance")), new BreadcrumbItem("Archive"));
}
<div id="ajax-page" class="stack" data-ajax-region>
    <section class="card" aria-labelledby="maintenance-archive-label">
        <p class="card__subtitle" id="maintenance-archive-label">
            Maintenance windows filed away from the working list. Nothing here is deleted: each one
            keeps its schedule, reason and occurrence history, and restoring one puts it back on the
            maintenance list unchanged.
        </p>
        <div class="form-actions">
            <a class="button button--secondary" asp-action="Index" data-ajax-link data-ajax-target="#ajax-page">
                @await Html.PartialAsync("_Icon", "arrow-left")
                <span>Back to maintenance</span>
            </a>
        </div>
    </section>

    @if (Model.Windows.Count == 0)
    {
        <section class="card">
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "The archive is empty",
                "Archiving cancelled and finished maintenance windows from the maintenance list moves them here.",
                "archive"))
        </section>
    }
    else
    {
        <section class="card" aria-labelledby="maintenance-archive-heading">
            <div class="page-intro">
                <div>
                    <h3 class="card__title" id="maintenance-archive-heading">Archived maintenance windows</h3>
                    <p class="card__status" data-status="neutral">
                        @await Html.PartialAsync("_Icon", "archive")
                        <span>@Model.Windows.Count archived window@(Model.Windows.Count == 1 ? null : "s")</span>
                    </p>
                </div>
            </div>

            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">Archived maintenance windows</caption>
                    <thead>
                        <tr>
                            <th scope="col">Scope</th>
                            <th scope="col">Window</th>
                            <th scope="col">Repeats</th>
                            <th scope="col">Status</th>
                            <th scope="col">Archived</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var window in Model.Windows)
                        {
                            <tr>
                                <td data-label="Scope"><span class="data-table__primary">@window.ScopeLabel</span></td>
                                <td data-label="Window">@Html.Timestamp(window.StartsAt) &ndash; @Html.Timestamp(window.EndsAt)</td>
                                <td data-label="Repeats">@MaintenanceRecurrenceDisplay.Describe(window.Recurrence)</td>
                                <td data-label="Status">
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                        MaintenanceStatusDisplay.Badge(window),
                                        MaintenanceStatusDisplay.Name(window),
                                        MaintenanceStatusDisplay.Detail(window)))
                                </td>
                                <td data-label="Archived">@Html.Timestamp(window.ArchivedAt, "—")</td>
                                <td class="data-table__action" data-label="Actions">
                                    <span class="data-table__action-group">
                                        <a asp-action="Details" asp-route-id="@window.Id">View</a>
                                        <form method="post" asp-action="Restore" data-ajax-form data-ajax-target="#ajax-page">
                                            <input type="hidden" name="id" value="@window.Id" />
                                            <input type="hidden" name="version" value="@window.Version" />
                                            <button class="button button--secondary button--icon" type="submit"
                                                    title="Put this maintenance window back on the maintenance list"
                                                    aria-label="Restore the maintenance window for @window.ScopeLabel">
                                                @await Html.PartialAsync("_Icon", "restore")
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
