@model MaintenanceDetailsViewModel
@{ ViewData.SetTitle("Maintenance details"); ViewData.SetBreadcrumbs(new BreadcrumbItem("Maintenance", "/Maintenance"), new BreadcrumbItem("Details")); }
<section class="card"><div class="page-intro"><div><h2 class="card__title">Maintenance window</h2><p class="card__subtitle">@Model.Window.ScopeLabel · Version @Model.Window.Version</p></div><div class="form-actions">@if (!Model.Window.IsCancelled) { <a class="button button--primary" asp-action="Edit" asp-route-id="@Model.Window.Id">Edit</a> }</div></div>
    <dl class="registry-facts"><div><dt>Status</dt><dd><span class="badge" data-status="@(Model.Window.IsCancelled ? "danger" : "warning")">@(Model.Window.IsCancelled ? "Cancelled" : "Scheduled")</span></dd></div><div><dt>First occurrence starts (UTC)</dt><dd>@Model.Window.StartsAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</dd></div><div><dt>First occurrence ends (UTC)</dt><dd>@Model.Window.EndsAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</dd></div><div><dt>Display timezone</dt><dd>@Model.Window.TimezoneId</dd></div><div><dt>Repeats</dt><dd>@MaintenanceRecurrenceDisplay.Describe(Model.Window.Recurrence)</dd></div><div><dt>Next occurrence (UTC)</dt><dd>@(Model.Window.NextOccurrenceStartsAt?.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "None remaining")</dd></div><div><dt>Materialised occurrences</dt><dd>@Model.Window.OccurrenceCount</dd></div><div><dt>Notification policy</dt><dd>@(Model.Window.SuppressionPolicy == "SuppressAll" ? "Suppress all notifications" : "Do not suppress notifications")</dd></div><div><dt>Escalation</dt><dd>@(Model.Window.PauseEscalation ? "Paused while active" : "Continues while active")</dd></div><div><dt>Failure confirmation</dt><dd>@(Model.Window.ContinueFailureCounter ? "Continues after maintenance" : "Restarts after maintenance")</dd></div><div><dt>Reason</dt><dd>@Model.Window.Reason</dd></div></dl>
    @if (!Model.Window.IsCancelled) { <div class="registry-lifecycle"><form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@Model.Window.Id" /><input type="hidden" name="version" value="@Model.Window.Version" /><button class="button button--danger" type="submit">Cancel maintenance</button></form></div> }
</section>
