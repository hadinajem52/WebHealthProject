@model MaintenanceWindowFormViewModel
<div class="form-field"><label asp-for="ScopeKind"></label><select asp-for="ScopeKind" class="form-select" data-maintenance-scope-kind>@foreach (var kind in Enum.GetValues<MaintenanceScopeKind>()) { <option value="@kind">@kind</option> }</select><span asp-validation-for="ScopeKind"></span></div>
<div class="form-field"><label asp-for="ScopeId"></label><select asp-for="ScopeId" class="form-select" data-maintenance-scope-target><option value="">Select a target</option>@foreach (var option in Model.ScopeOptions) { <option value="@option.Id" data-scope="@option.Kind">@option.Label</option> }</select><span asp-validation-for="ScopeId"></span></div>
<div class="form-grid"><div class="form-field"><label asp-for="StartsAtUtc"></label><input asp-for="StartsAtUtc" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span asp-validation-for="StartsAtUtc"></span></div><div class="form-field"><label asp-for="EndsAtUtc"></label><input asp-for="EndsAtUtc" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span asp-validation-for="EndsAtUtc"></span></div></div>
<div class="form-field"><label asp-for="TimezoneId"></label><input asp-for="TimezoneId" autocomplete="off" /><span class="form-hint">Use an IANA identifier such as <code>Asia/Beirut</code>. Times above are submitted as UTC.</span><span asp-validation-for="TimezoneId"></span></div>
<div class="form-field"><label asp-for="RecurrencePattern"></label><select asp-for="RecurrencePattern" class="form-select" data-maintenance-recurrence><option value="@MaintenanceRecurrencePatterns.None">Does not repeat</option><option value="@MaintenanceRecurrencePatterns.Daily">Daily</option><option value="@MaintenanceRecurrencePatterns.Weekly">Weekly</option></select><span class="form-hint">A repeating window recurs at the same local wall-clock time in the timezone above. Occurrences are materialised ahead of time.</span><span asp-validation-for="RecurrencePattern"></span></div>
<div class="form-field" data-maintenance-recurrence-days><label asp-for="RecurrenceDays"></label><div class="form-check-group">@foreach (var day in Enum.GetValues<DayOfWeek>()) { <label class="form-check"><input type="checkbox" name="RecurrenceDays[@((int)day)]" value="true" checked="@(Model.RecurrenceDays.Length > (int)day && Model.RecurrenceDays[(int)day])" /><input type="hidden" name="RecurrenceDays[@((int)day)]" value="false" /><span>@day.ToString()[..3]</span></label> }</div><span class="form-hint">Weekly windows must include the day the first occurrence starts.</span></div>
<div class="form-field" data-maintenance-recurrence-until><label asp-for="RecurrenceUntilUtc"></label><input asp-for="RecurrenceUntilUtc" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span class="form-hint">Leave empty for an open-ended recurrence.</span><span asp-validation-for="RecurrenceUntilUtc"></span></div>
<div class="form-field"><label asp-for="Reason"></label><textarea asp-for="Reason" rows="3"></textarea><span asp-validation-for="Reason"></span></div>
<div class="form-field"><label asp-for="SuppressionPolicy"></label><select asp-for="SuppressionPolicy" class="form-select"><option value="SuppressAll">Suppress all notifications</option><option value="None">Do not suppress notifications</option></select></div>
<div class="form-check"><input asp-for="PauseEscalation" /><label asp-for="PauseEscalation"></label></div>
<div class="form-check"><input asp-for="ContinueFailureCounter" /><label asp-for="ContinueFailureCounter"></label><span class="form-hint">Leave unchecked to restart failure confirmation after maintenance ends.</span></div>
