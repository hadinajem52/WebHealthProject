@model MaintenanceWindowFormViewModel
@{
    ViewData.SetTitle("Schedule maintenance");
    ViewData.SetBreadcrumbs(
        new BreadcrumbItem("Maintenance", "/Maintenance"),
        new BreadcrumbItem("Schedule"));
}

<section class="card form-card">
    <h2 class="card__title">Schedule maintenance</h2>
    <p class="card__subtitle">
        Checks keep running inside a maintenance window. What the window changes is what gets
        sent, and each occurrence is stored as an immutable UTC record.
    </p>

    <form asp-action="Create"
          method="post"
          class="form-stack"
          id="ajax-form-region"
          data-ajax-region
          data-ajax-form
          data-ajax-target="#ajax-form-region">
        <partial name="_AjaxValidationSummary" />
        <partial name="_Form" model="Model" />

        <div class="form-actions">
            <button class="button button--primary" type="submit">
                @await Html.PartialAsync("_Icon", "plus")
                <span>Schedule window</span>
            </button>
            <a class="button button--secondary" asp-action="Index">
                @await Html.PartialAsync("_Icon", "close")
                <span>Cancel</span>
            </a>
        </div>
    </form>
</section>
