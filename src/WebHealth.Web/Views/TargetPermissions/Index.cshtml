@model TargetPermissionsViewModel
@{
    ViewData.SetTitle("Target permissions");
    var permissionPage = Model.Permissions!;
    ViewData.SetBreadcrumbs(Breadcrumbs.Registry(Url), Breadcrumbs.Endpoints(Url),
        Breadcrumbs.Endpoint(Url, permissionPage.EndpointId, permissionPage.Url), new BreadcrumbItem("Target permissions"));
}
<div class="stack">
    <section class="card form-card">
        <div class="page-intro">
            <div>
                <h2 class="card__title">Target permissions</h2>
                <p class="card__subtitle">Authorize only websites you own or have permission to test. A permission covers one host and port for this endpoint, including redirects to that destination.</p>
            </div>
            <a class="button button--secondary" asp-controller="Targets" asp-action="Endpoint" asp-route-id="@permissionPage.EndpointId">Back to endpoint</a>
        </div>
        <form asp-action="Grant" method="post" class="form-stack">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="validation-summary"></div>
            }
            <input asp-for="EndpointId" type="hidden" />
            <div class="form-field">
                <label asp-for="Url">Target URL</label>
                <input asp-for="Url" type="url" required />
                <span asp-validation-for="Url"></span>
            </div>
            <div class="form-field">
                <label asp-for="Kind">Permission basis</label>
                <select asp-for="Kind"><option value="Owned">I own this target</option><option value="ExplicitPermission">Explicit permission from the owner</option></select>
            </div>
            <div class="form-field">
                <label asp-for="EvidenceReference">Evidence reference</label>
                <textarea asp-for="EvidenceReference" rows="3" maxlength="500" required></textarea>
                <p class="form-hint">Reference the ownership record or permission you hold. Do not include credentials or secrets.</p>
                <span asp-validation-for="EvidenceReference"></span>
            </div>
            <div class="form-field">
                <label asp-for="ExpiresAt">Expiry (optional, include time zone)</label>
                <input asp-for="ExpiresAt" type="text" placeholder="2026-12-31T23:59:00Z" />
                <span asp-validation-for="ExpiresAt"></span>
            </div>
            <div class="form-actions"><button type="submit" class="button button--primary">Grant permission</button></div>
        </form>
    </section>
    <section class="card">
        <h2 class="card__title">Permission history</h2>
        <p class="card__subtitle">Revocation prevents new connections. A connection already in progress may finish. Permission references are kept out of monitoring results and logs.</p>
        <div class="table-scroll">
            <table class="data-table">
                <thead><tr><th scope="col">Host and port</th><th scope="col">Basis</th><th scope="col">Expiry</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
                <tbody>
                @foreach (var item in permissionPage.Items)
                {
                    <tr>
                        <td>@item.Host:@item.Port</td>
                        <td>@(item.Kind == "Owned" ? "Owned" : "Explicit permission")</td>
                        <td>@Html.TimestampWithSeconds(item.ExpiresAt, "No expiry")</td>
                        <td>@(item.RevokedAt is not null ? "Revoked" : item.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired" : "Active")</td>
                        <td>
                        @if (item.RevokedAt is null)
                        {
                            <form asp-action="Revoke" method="post" class="form-stack">
                                <input type="hidden" name="endpointId" value="@permissionPage.EndpointId" />
                                <input type="hidden" name="permissionId" value="@item.Id" />
                                <label for="reason-@item.Id">Revocation reason</label>
                                <input id="reason-@item.Id" name="reason" maxlength="500" required />
                                <button type="submit" class="button button--secondary">Revoke permission</button>
                            </form>
                        }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (permissionPage.Items.Count == 0)
        {
            <p class="card__subtitle">No permission has been recorded. Monitoring cannot connect until permission is granted.</p>
        }
    </section>
</div>
