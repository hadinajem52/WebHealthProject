@model RegistryArchiveViewModel
@{
    ViewData.SetTitle("Archived registry");
    ViewData.SetBreadcrumbs(Breadcrumbs.Registry(Url), new BreadcrumbItem("Archived"));
}

<section class="card">
    <div class="page-intro">
        <div>
            <h2 class="card__title">Archived registry</h2>
            <p class="card__subtitle">Soft-deleted records are excluded from active lists but remain available for restoration and audit history.</p>
        </div>
        <a class="button button--secondary" asp-action="Clients">Active registry</a>
    </div>

    <h3 class="card__title">Clients</h3>
    @if (Model.Clients.Count == 0)
    {
        <p class="card__subtitle">No archived clients.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead><tr><th>Client</th><th>Owner</th><th>Deleted status</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var client in Model.Clients)
                {
                    <tr><td data-label="Client"><span class="data-table__primary">@client.Name</span><span class="data-table__secondary">Version @client.Version</span></td><td data-label="Owner">@client.OwnerName</td><td data-label="Deleted status"><span class="badge" data-status="danger">Deleted</span></td><td class="data-table__action" data-label="Actions"><a asp-action="Client" asp-route-id="@client.Id">Review</a></td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card">
    <h3 class="card__title">Websites</h3>
    @if (Model.Websites.Count == 0)
    {
        <p class="card__subtitle">No archived websites.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead><tr><th>Website</th><th>Client</th><th>Owner</th><th>Deleted status</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var website in Model.Websites)
                {
                    <tr><td data-label="Website"><span class="data-table__primary">@website.Name</span><span class="data-table__secondary">Version @website.Version</span></td><td data-label="Client">@website.ClientName</td><td data-label="Owner">@website.OwnerName</td><td data-label="Deleted status"><span class="badge" data-status="danger">Deleted</span></td><td class="data-table__action" data-label="Actions"><a asp-action="Website" asp-route-id="@website.Id">Review</a></td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
