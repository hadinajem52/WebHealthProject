@model WebsiteFormViewModel
@{
    ViewData.SetTitle("Add website");
    ViewData.SetBreadcrumbs(Breadcrumbs.Registry(Url), Breadcrumbs.Websites(Url), new BreadcrumbItem("Add website"));
}
<section class="card form-card">
    <h2 class="card__title">Add website</h2><p class="card__subtitle">Create a website disabled, then add an environment before enabling it.</p>
    <form asp-action="CreateWebsite" method="post" class="form-stack"><partial name="_WebsiteForm" model="Model" /><div class="form-actions">
        <button class="button button--primary" type="submit">
            @await Html.PartialAsync("_Icon", "plus")
            <span>Create website</span>
        </button>
        <a class="button button--secondary" asp-action="Websites">
            @await Html.PartialAsync("_Icon", "close")
            <span>Cancel</span>
        </a>
    </div></form>
</section>
