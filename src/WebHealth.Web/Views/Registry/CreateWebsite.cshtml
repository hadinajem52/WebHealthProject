@model WebsiteFormViewModel
@{
    ViewData.SetTitle("Add website");
    ViewData.SetBreadcrumbs(new BreadcrumbItem("Registry"), new BreadcrumbItem("Websites", Url.Action("Websites")), new BreadcrumbItem("Add website"));
}
<section class="card form-card">
    <h2 class="card__title">Add website</h2><p class="card__subtitle">Create a website disabled, then add an environment before enabling it.</p>
    <form asp-action="CreateWebsite" method="post" class="form-stack"><partial name="_WebsiteForm" model="Model" /><div class="form-actions"><button class="button button--primary" type="submit">Create website</button><a class="button button--secondary" asp-action="Websites">Cancel</a></div></form>
</section>
