@model WebsiteDetailsViewModel
@{
    ViewData.SetTitle(Model.Website.Name);
    ViewData.SetBreadcrumbs(Breadcrumbs.Registry(Url), Breadcrumbs.Websites(Url), new BreadcrumbItem(Model.Website.Name));

    var website = Model.Website;
    var websiteTone = website.IsDeleted ? StatusBadges.Danger
        : website.IsEnabled ? StatusBadges.Success
        : StatusBadges.Warning;
    var websiteState = website.IsDeleted ? "Archived"
        : website.IsEnabled ? "Enabled"
        : "Disabled";
}

<div id="ajax-page" class="stack" data-ajax-region>
    <section class="card" aria-labelledby="website-heading">
        <div class="page-intro">
            <div>
                <h2 class="card__title" id="website-heading">@website.Name</h2>
                <p class="card__status" data-status="@websiteTone">
                    @await Html.PartialAsync("_Icon", StatusBadges.Icon(websiteTone))
                    <span>Website &middot; @websiteState</span>
                </p>
            </div>

            <div class="form-actions">
                @if (!website.IsDeleted)
                {
                    <a class="button button--secondary"
                       asp-controller="Targets"
                       asp-action="Environments"
                       asp-route-websiteId="@website.Id">
                        @await Html.PartialAsync("_Icon", "building")
                        <span>Environments</span>
                    </a>
                }

                @if (Model.CanManage && !website.IsDeleted)
                {
                    <a class="button button--secondary"
                       asp-controller="Targets"
                       asp-action="CreateEnvironment"
                       asp-route-websiteId="@website.Id">
                        @await Html.PartialAsync("_Icon", "plus")
                        <span>Add environment</span>
                    </a>

                    <a class="button button--primary" asp-action="EditWebsite" asp-route-id="@website.Id">
                        @await Html.PartialAsync("_Icon", "pencil")
                        <span>Edit website</span>
                    </a>
                }

                
                @if (Model.CanManage)
                {
                    <div class="action-menu" data-shell-menu data-open="false">
                        <button type="button"
                                class="button button--secondary"
                                data-shell-menu-toggle
                                aria-controls="website-actions-menu"
                                aria-expanded="false"
                                aria-haspopup="true">
                            @await Html.PartialAsync("_Icon", "settings")
                            <span>Actions</span>
                            <span class="button__caret">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                        </button>

                        <div class="action-menu__panel" id="website-actions-menu" data-shell-menu-panel>
                            @if (website.IsDeleted)
                            {
                                <form asp-action="RestoreWebsite" method="post" data-ajax-form data-ajax-target="#ajax-page">
                                    <input type="hidden" name="id" value="@website.Id" />
                                    <input type="hidden" name="version" value="@website.Version" />
                                    <button class="action-menu__item" type="submit"
                                            title="Restore returns this website in a disabled state.">
                                        @await Html.PartialAsync("_Icon", "restore")
                                        <span>Restore website</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                @if (website.IsEnabled)
                                {
                                    <form asp-action="DisableWebsite" method="post" data-ajax-form data-ajax-target="#ajax-page">
                                        <input type="hidden" name="id" value="@website.Id" />
                                        <input type="hidden" name="version" value="@website.Version" />
                                        <button class="action-menu__item" type="submit">
                                            @await Html.PartialAsync("_Icon", "power")
                                            <span>Disable website</span>
                                        </button>
                                    </form>
                                }

                                <hr class="action-menu__separator" />
                                <form asp-action="DeleteWebsite" method="post" data-ajax-form data-ajax-target="#ajax-page">
                                    <input type="hidden" name="id" value="@website.Id" />
                                    <input type="hidden" name="version" value="@website.Version" />
                                    <button class="action-menu__item action-menu__item--danger" type="submit"
                                            title="Archiving is a soft delete: history and audit evidence are retained.">
                                        @await Html.PartialAsync("_Icon", "archive")
                                        <span>Archive website</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="detail-list">
            <div class="detail-list__head" aria-hidden="true">
                <span>Subject</span>
                <span>Status</span>
            </div>
            <ul class="detail-list__items">
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "building")</span>
                            <span>Client</span>
                        </span>
                        <span class="detail-list__value">
                            <a asp-action="Client" asp-route-id="@website.ClientId">@website.ClientName</a>
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "person")</span>
                            <span>Owner</span>
                        </span>
                        <span class="detail-list__value">@website.OwnerName</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "settings")</span>
                            <span>Technology / CMS</span>
                        </span>
                        <span class="detail-list__value">@(website.TechnologyCms ?? "Not set")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "activity")</span>
                            <span>Active environments</span>
                        </span>
                        <span class="detail-list__value">@website.ActiveEnvironmentCount</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "filter")</span>
                            <span>Tags</span>
                        </span>
                        <span class="detail-list__value">
                            @if (website.Tags.Count == 0)
                            {
                                <span>None</span>
                            }
                            else
                            {
                                <span class="tag-list tag-list--compact">
                                    @foreach (var tag in website.Tags)
                                    {
                                        <span class="tag">@tag</span>
                                    }
                                </span>
                            }
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "key")</span>
                            <span>Version</span>
                        </span>
                        <span class="detail-list__value">@website.Version</span>
                    </div>
                </li>
            </ul>
        </div>
    </section>
</div>
