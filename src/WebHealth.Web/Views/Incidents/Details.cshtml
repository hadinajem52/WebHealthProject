@model IncidentDetailsViewModel
@using WebHealth.Application.Incidents
@{
    ViewData.SetTitle("Incident details");
    ViewData.SetBreadcrumbs(new BreadcrumbItem("Incidents", "/Incidents"), new BreadcrumbItem("Details"));
    var incident = Model.Incident;
    var isGlobal = User.IsInRole("Administrator") || User.IsInRole("Operations");
    var isAdministrator = User.IsInRole("Administrator");
    var isActive = incident.Status is "Open" or "Acknowledged" or "InProgress" or "MonitoringRecovery";

    var incidentStatus = StatusBadges.ForIncidentStatus(incident.Status);
    var severityStatus = StatusBadges.ForSeverity(incident.Severity);

    var canAcknowledge = incident.CanManage && incident.Status == "Open";
    var canStartProgress = incident.CanManage && incident.Status == "Acknowledged";
    var canCloseIncident = incident.CanManage && incident.Status == "Resolved";
    var hasQuickActions = canAcknowledge || canStartProgress || canCloseIncident;

    var canResolve = incident.CanManage && isActive;
    var canAddNote = incident.CanManage && incident.Status != "Closed";
    var canReassign = incident.CanManage && isGlobal && incident.Status != "Closed" && Model.OwnerOptions.Count > 0;
    var canForceClose = isAdministrator && incident.Status != "Closed";
    var canReopen = isAdministrator && incident.Status == "Closed";
    var hasManageForms = hasQuickActions || canResolve || canAddNote || canReassign
        || canForceClose || canReopen;

    var timeline = incident.Timeline;
    var timelineFirstVisible = timeline.TotalCount == 0 ? 0 : ((timeline.Page - 1) * timeline.PageSize) + 1;
    var timelineLastVisible = Math.Min(timeline.Page * timeline.PageSize, timeline.TotalCount);
    var timelineHasPrevious = timeline.Page > 1;
    var timelineHasNext = timelineLastVisible < timeline.TotalCount;

    var milestones = incident.EvidenceMilestones;
    var samples = incident.FailureSamples;
    var sampleSummary = incident.FailureSampleSummary;
    var sampleFirstVisible = samples.TotalCount == 0 ? 0 : ((samples.Page - 1) * samples.PageSize) + 1;
    var sampleLastVisible = Math.Min(samples.Page * samples.PageSize, samples.TotalCount);
    var sampleHasPrevious = samples.Page > 1;
    var sampleHasNext = sampleLastVisible < samples.TotalCount;

    static string StatusIcon(string status) => status switch
    {
        "success" => "success",
        "danger" => "error",
        _ => "warning"
    };

    static string DeliveryBadge(string state) => state switch
    {
        "Sent" => "success",
        "FailedPermanently" => "danger",
        "Suppressed" => "warning",
        _ => "warning"
    };
}

<div id="ajax-page" class="stack" data-ajax-region data-incident-workspace>
    <section class="card">
        <div class="page-intro">
            <div>
                <h2 class="card__title target-url">@incident.EndpointDisplayUrl</h2>
                <p class="card__status" data-status="@severityStatus">
                    @await Html.PartialAsync("_Icon", StatusIcon(incidentStatus))
                    <span>@IssueDisplay.Describe(incident.IssueKey) &middot; @IncidentStatusDisplay.Name(incident.Status)</span>
                </p>
                <p class="card__subtitle">@incident.ClientName / @incident.WebsiteName / @incident.EnvironmentName</p>
            </div>
            <div class="form-actions">
                @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(StatusBadges.ForSeverity(incident.Severity), incident.Severity))
                @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(incidentStatus, IncidentStatusDisplay.Name(incident.Status)))

            </div>
        </div>

        <div class="detail-list">
            <div class="detail-list__head" aria-hidden="true">
                <span>Subject</span>
                <span>Status</span>
            </div>
            <ul class="detail-list__items">
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "person")</span>
                            <span>Owner</span>
                        </span>
                        <span class="detail-list__value">@incident.OwnerDisplayName</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                            <span>Opened</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.OpenedAt)</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "check")</span>
                            <span>Acknowledged</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.AcknowledgedAt, "Not yet")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "restore")</span>
                            <span>Recovery started</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.RecoveryStartedAt, "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "shield-check")</span>
                            <span>Resolved</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.ResolvedAt, "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "archive")</span>
                            <span>Closed</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.ClosedAt, "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "speed")</span>
                            <span>Outage duration</span>
                        </span>
                        <span class="detail-list__value">@(incident.OutageDurationMs is { } outage ? $"{TimeSpan.FromMilliseconds(outage):g}" : "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "reports")</span>
                            <span>Recurrence</span>
                        </span>
                        <span class="detail-list__value">@incident.RecurrenceCount</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "audit")</span>
                            <span>Resolution</span>
                        </span>
                        <span class="detail-list__value">
                            <span>@(incident.ResolutionCategory ?? "—")</span>
                            @if (incident.ResolutionNote is not null)
                            {
                                <span class="detail-list__note">@incident.ResolutionNote</span>
                            }
                        </span>
                    </div>
                </li>
            </ul>
        </div>
    </section>

@if (hasManageForms)
    {
        <section class="card">
            <div class="page-intro">
                <div>
                    <h3 class="card__title">Manage incident</h3>
                    <p class="card__status" data-status="neutral">
                        @await Html.PartialAsync("_Icon", "settings")
                        <span>Everything you can do to this incident from here</span>
                    </p>
                </div>
            </div>

            @if (canAcknowledge)
            {
                <div class="form-actions">
                    <form asp-action="Acknowledge" method="post" data-ajax-form data-ajax-target="#ajax-page">
                        <input type="hidden" name="id" value="@incident.Id" />
                        <input type="hidden" name="version" value="@incident.Version" />
                        <button class="button button--primary" type="submit">
                            @await Html.PartialAsync("_Icon", "check")
                            <span>Acknowledge</span>
                        </button>
                    </form>
                    <p class="disclosure__description">Records that someone picked this up and moves it to Acknowledged.</p>
                </div>
            }
            @if (canStartProgress)
            {
                <div class="form-actions">
                    <form asp-action="StartProgress" method="post" data-ajax-form data-ajax-target="#ajax-page">
                        <input type="hidden" name="id" value="@incident.Id" />
                        <input type="hidden" name="version" value="@incident.Version" />
                        <button class="button button--primary" type="submit">
                            @await Html.PartialAsync("_Icon", "play")
                            <span>Start progress</span>
                        </button>
                    </form>
                    <p class="disclosure__description">Moves this incident to In progress.</p>
                </div>
            }
            @if (canCloseIncident)
            {
                <div class="form-actions">
                    <form asp-action="Close" method="post" data-ajax-form data-ajax-target="#ajax-page">
                        <input type="hidden" name="id" value="@incident.Id" />
                        <input type="hidden" name="version" value="@incident.Version" />
                        <button class="button button--primary" type="submit">
                            @await Html.PartialAsync("_Icon", "archive")
                            <span>Close incident</span>
                        </button>
                    </form>
                    <p class="disclosure__description">Moves this incident to Closed and takes it out of the active list.</p>
                </div>
            }

            @if (canResolve)
            {
                <details class="disclosure">
                    <summary class="disclosure__summary">
                        <span class="disclosure__chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                        <span class="disclosure__icon">@await Html.PartialAsync("_Icon", "shield-check")</span>
                        <span class="disclosure__title">Resolve incident</span>
                    </summary>
                    <div class="disclosure__body">
                        <p class="disclosure__description">Records the outcome and moves this incident to Resolved.</p>
                        <form asp-action="Resolve" method="post" class="lifecycle-action-form" data-ajax-form data-ajax-target="#ajax-page">
                            <input type="hidden" name="id" value="@incident.Id" />
                            <input type="hidden" name="version" value="@incident.Version" />
                            <div class="form-field"><label for="resolve-category">Resolution category</label><input id="resolve-category" type="text" name="category" maxlength="@IncidentLifecycleEngine.MaximumCategoryLength" required /></div>
                            <div class="form-field"><label for="resolve-note">Resolution note</label><textarea id="resolve-note" name="note" maxlength="@IncidentLifecycleEngine.MaximumNoteLength" required></textarea></div>
                            <button class="button button--primary" type="submit">
                                @await Html.PartialAsync("_Icon", "shield-check")
                                <span>Resolve incident</span>
                            </button>
                        </form>
                    </div>
                </details>
            }
            @if (canAddNote)
            {
                <details class="disclosure">
                    <summary class="disclosure__summary">
                        <span class="disclosure__chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                        <span class="disclosure__icon">@await Html.PartialAsync("_Icon", "plus")</span>
                        <span class="disclosure__title">Add note</span>
                    </summary>
                    <div class="disclosure__body">
                        <p class="disclosure__description">Adds a note to the timeline. The status and the owner stay as they are.</p>
                        <form asp-action="AddNote" method="post" class="lifecycle-action-form" data-ajax-form data-ajax-target="#ajax-page">
                            <input type="hidden" name="id" value="@incident.Id" />
                            <input type="hidden" name="version" value="@incident.Version" />
                            <div class="form-field"><label for="add-note">Note</label><textarea id="add-note" name="note" maxlength="@IncidentLifecycleEngine.MaximumNoteLength" required></textarea></div>
                            <button class="button button--secondary" type="submit">
                                @await Html.PartialAsync("_Icon", "plus")
                                <span>Add note</span>
                            </button>
                        </form>
                    </div>
                </details>
            }
            @if (canReassign)
            {
                <details class="disclosure">
                    <summary class="disclosure__summary">
                        <span class="disclosure__chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                        <span class="disclosure__icon">@await Html.PartialAsync("_Icon", "person")</span>
                        <span class="disclosure__title">Reassign</span>
                    </summary>
                    <div class="disclosure__body">
                        <p class="disclosure__description">Hands ownership to another user or team. The status stays as it is.</p>
                        <form asp-action="Reassign" method="post" class="lifecycle-action-form" data-ajax-form data-ajax-target="#ajax-page">
                            <input type="hidden" name="id" value="@incident.Id" />
                            <input type="hidden" name="version" value="@incident.Version" />
                            <div class="form-field">
                                <label for="reassign-owner">New owner</label>
                                <select id="reassign-owner" name="ownerSubjectId" required>
                                    @foreach (var owner in Model.OwnerOptions)
                                    {
                                        <option value="@owner.OwnerSubjectId">@owner.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <button class="button button--secondary" type="submit">
                                @await Html.PartialAsync("_Icon", "person")
                                <span>Reassign</span>
                            </button>
                        </form>
                    </div>
                </details>
            }

            @if (canForceClose || canReopen)
            {
                <p class="card__subtitle">Administrator overrides</p>
                @if (canForceClose)
                {
                    <details class="disclosure">
                        <summary class="disclosure__summary">
                            <span class="disclosure__chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                            <span class="disclosure__icon">@await Html.PartialAsync("_Icon", "power")</span>
                            <span class="disclosure__title">Force close</span>
                        </summary>
                        <div class="disclosure__body">
                            <p class="disclosure__description">Closes this incident whatever its current state, without waiting for recovery. The reason is recorded as the resolution.</p>
                            <form asp-action="ForceClose"
                                  method="post"
                                  class="lifecycle-action-form"
                                  data-ajax-form
                                  data-ajax-target="#ajax-page"
                                  data-shell-confirm="Force close this incident now, whatever its current state? The reason is recorded as an administrator override.">
                                <input type="hidden" name="id" value="@incident.Id" />
                                <input type="hidden" name="version" value="@incident.Version" />
                                <div class="form-field"><label for="force-close-reason">Administrator reason</label><textarea id="force-close-reason" name="reason" maxlength="@IncidentLifecycleEngine.MaximumAdministratorReasonLength" required></textarea></div>
                                <button class="button button--danger" type="submit">
                                    @await Html.PartialAsync("_Icon", "power")
                                    <span>Force close</span>
                                </button>
                            </form>
                        </div>
                    </details>
                }
                @if (canReopen)
                {
                    <details class="disclosure">
                        <summary class="disclosure__summary">
                            <span class="disclosure__chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                            <span class="disclosure__icon">@await Html.PartialAsync("_Icon", "restore")</span>
                            <span class="disclosure__title">Reopen</span>
                        </summary>
                        <div class="disclosure__body">
                            <p class="disclosure__description">Moves this closed incident back to Open and clears the recorded resolution.</p>
                            <form asp-action="Reopen"
                                  method="post"
                                  class="lifecycle-action-form"
                                  data-ajax-form
                                  data-ajax-target="#ajax-page"
                                  data-shell-confirm="Reopen this closed incident? The recorded resolution is cleared and the reason is kept as an administrator override.">
                                <input type="hidden" name="id" value="@incident.Id" />
                                <input type="hidden" name="version" value="@incident.Version" />
                                <div class="form-field"><label for="reopen-reason">Administrator reason</label><textarea id="reopen-reason" name="reason" maxlength="@IncidentLifecycleEngine.MaximumAdministratorReasonLength" required></textarea></div>
                                <button class="button button--secondary" type="submit">
                                    @await Html.PartialAsync("_Icon", "restore")
                                    <span>Reopen</span>
                                </button>
                            </form>
                        </div>
                    </details>
                }
            }
        </section>
    }

    <section class="card">
        <div class="page-intro">
            <div>
                <h3 class="card__title">Timeline</h3>
                <p class="card__status" data-status="neutral">
                    @await Html.PartialAsync("_Icon", "clock")
                    <span>State changes, notes and reassignments &middot; @timeline.TotalCount event@(timeline.TotalCount == 1 ? null : "s")</span>
                </p>
            </div>
        </div>
        @if (timeline.TotalCount == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "No timeline events",
                "Status changes, reassignments and notes will appear here as they happen.",
                "clock"))
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table data-table--history">
                    <caption class="visually-hidden">Incident timeline</caption>
                    <thead>
                        <tr>
                            <th scope="col">Subject</th>
                            <th scope="col">Detail</th>
                            <th scope="col">Actor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in timeline.Items)
                        {
                            <tr>
                                <td data-label="Subject">
                                    <span class="history-cell">
                                        @await Html.PartialAsync("_HistoryMark", IncidentEventDisplay.Tone(entry))
                                        <span class="history-cell__subject">@IncidentEventDisplay.Name(entry)</span>
                                        <span class="history-cell__time">
                                            @Html.TimestampWithSeconds(entry.OccurredAt)
                                            @if (IncidentEventDisplay.Elapsed(entry.ElapsedSincePrevious) is { } elapsed)
                                            {
                                                <text>&middot; @elapsed</text>
                                            }
                                        </span>
                                    </span>
                                </td>
                                <td data-label="Detail">
                                    @if (entry.EventType == "StatusChanged")
                                    {
                                        <span>@IncidentStatusDisplay.Name(entry.FromStatus ?? "") → @IncidentStatusDisplay.Name(entry.ToStatus ?? "")</span>
                                        @if (entry.Note is { Length: > 0 } statusNote)
                                        {
                                            <span class="data-table__secondary">@statusNote</span>
                                        }
                                    }
                                    else if (entry.EventType == "Reassigned")
                                    {
                                        <span>@entry.FromOwnerDisplayName → @entry.ToOwnerDisplayName</span>
                                    }
                                    else if (entry.Note is { Length: > 0 } note)
                                    {
                                        <span>@note</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td data-label="Actor">@(entry.ActorDisplayName ?? "System")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pagination" aria-label="Timeline pages">
                <span>Showing @timelineFirstVisible–@timelineLastVisible of @timeline.TotalCount</span>
                <span class="pagination__actions">
                    @if (timelineHasPrevious)
                    {
                        <a class="button button--secondary" asp-route-id="@incident.Id" asp-route-timelinePage="@(timeline.Page - 1)" asp-route-samplePage="@samples.Page" data-ajax-link data-ajax-target="#ajax-page">
                            @await Html.PartialAsync("_Icon", "arrow-left")
                            <span>Previous</span>
                        </a>
                    }
                    @if (timelineHasNext)
                    {
                        <a class="button button--secondary" asp-route-id="@incident.Id" asp-route-timelinePage="@(timeline.Page + 1)" asp-route-samplePage="@samples.Page" data-ajax-link data-ajax-target="#ajax-page">
                            <span>Next</span>
                            @await Html.PartialAsync("_Icon", "arrow-right")
                        </a>
                    }
                </span>
            </nav>
        }
    </section>

    <section class="card">
        <div class="page-intro">
            <div>
                <h3 class="card__title">Evidence</h3>
                <p class="card__status" data-status="neutral">
                    @await Html.PartialAsync("_Icon", "audit")
                    <span>What the checks saw &middot; @milestones.Count milestone@(milestones.Count == 1 ? null : "s")</span>
                </p>
            </div>
        </div>
        @if (milestones.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "No evidence recorded",
                "Snapshots are captured at each confirmation step.",
                "empty"))
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table data-table--history">
                    <caption class="visually-hidden">Incident milestones and the check that proved each one</caption>
                    <thead>
                        <tr>
                            <th scope="col">What happened</th>
                            <th scope="col">Proof</th>
                            <th scope="col"><span class="visually-hidden">Check</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var milestone in milestones)
                        {
                            <tr>
                                <td data-label="What happened">
                                    <span class="history-cell">
                                        @await Html.PartialAsync("_HistoryMark", IncidentEvidenceDisplay.Tone(milestone.EvidenceRole))
                                        <span class="history-cell__subject">@IncidentEvidenceDisplay.Name(milestone.EvidenceRole)</span>
                                        <span class="history-cell__time">@Html.TimestampWithSeconds(milestone.CapturedAt)</span>
                                    </span>
                                </td>
                                <td data-label="Proof">@IncidentEvidenceDisplay.Proof(milestone)</td>
                                <td data-label="Check">
                                    @if (milestone.LogicalCheckId is { } milestoneCheckId)
                                    {
                                        <a asp-controller="Checks" asp-action="Check" asp-route-id="@milestoneCheckId">Open check</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (sampleSummary is not null)
    {
        <section class="card">
            <div class="page-intro">
                <div>
                    <h3 class="card__title">Failure samples</h3>
                    <p class="card__status" data-status="danger">
                        @await Html.PartialAsync("_Icon", "error")
                        <span>
                            @sampleSummary.Count repeated confirmation@(sampleSummary.Count == 1 ? null : "s")
                            between @Html.TimestampWithSeconds(sampleSummary.FirstCapturedAt)
                            and @Html.TimestampWithSeconds(sampleSummary.LastCapturedAt)
                        </span>
                    </p>
                    <p class="card__subtitle">
                        @string.Join(" · ", sampleSummary.Severities.Select(severity =>
                            $"{severity.Severity ?? "Unclassified"} ×{severity.Count}"))
                    </p>
                </div>
            </div>

            <div class="table-scroll table-scroll--flush">
                <table class="data-table data-table--history">
                    <caption class="visually-hidden">Every check that confirmed this failure again</caption>
                    <thead>
                        <tr>
                            <th scope="col">Captured</th>
                            <th scope="col">Severity</th>
                            <th scope="col">Proof</th>
                            <th scope="col"><span class="visually-hidden">Check</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sample in samples.Items)
                        {
                            <tr>
                                <td data-label="Captured">@Html.TimestampWithSeconds(sample.CapturedAt)</td>
                                <td data-label="Severity">
                                    @if (sample.Proof?.Severity is { } sampleSeverity)
                                    {
                                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                            StatusBadges.ForSeverity(sampleSeverity), sampleSeverity))
                                    }
                                </td>
                                <td data-label="Proof">@IncidentEvidenceDisplay.Proof(sample)</td>
                                <td data-label="Check">
                                    @if (sample.LogicalCheckId is { } sampleCheckId)
                                    {
                                        <a asp-controller="Checks" asp-action="Check" asp-route-id="@sampleCheckId">Open check</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pagination" aria-label="Failure sample pages">
                <span>Showing @sampleFirstVisible–@sampleLastVisible of @samples.TotalCount</span>
                <span class="pagination__actions">
                    @if (sampleHasPrevious)
                    {
                        <a class="button button--secondary" asp-route-id="@incident.Id" asp-route-timelinePage="@timeline.Page" asp-route-samplePage="@(samples.Page - 1)" data-ajax-link data-ajax-target="#ajax-page">
                            @await Html.PartialAsync("_Icon", "arrow-left")
                            <span>Previous</span>
                        </a>
                    }
                    @if (sampleHasNext)
                    {
                        <a class="button button--secondary" asp-route-id="@incident.Id" asp-route-timelinePage="@timeline.Page" asp-route-samplePage="@(samples.Page + 1)" data-ajax-link data-ajax-target="#ajax-page">
                            <span>Next</span>
                            @await Html.PartialAsync("_Icon", "arrow-right")
                        </a>
                    }
                </span>
            </nav>
        </section>
    }

    <section class="card">
        <div class="page-intro">
            <div>
                <h3 class="card__title">Notifications</h3>
                <p class="card__status" data-status="neutral">
                    @await Html.PartialAsync("_Icon", "bell")
                    <span>Delivery and suppression &middot; @incident.Notifications.Count notification@(incident.Notifications.Count == 1 ? null : "s")</span>
                </p>
            </div>
        </div>
        @if (incident.Notifications.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "No notifications yet",
                "Nothing this incident triggered has been sent or suppressed so far.",
                "bell"))
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">Notifications triggered by this incident</caption>
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Event</th>
                            <th scope="col">Suppressed</th>
                            <th scope="col">Recipients</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var notification in incident.Notifications)
                        {
                            <tr>
                                <td data-label="When">@Html.TimestampWithSeconds(notification.OccurredAt)</td>
                                <td data-label="Event"><span class="tag">@notification.EventType</span></td>
                                <td data-label="Suppressed">
                                    @if (notification.IsSuppressed)
                                    {
                                        <span class="badge" data-status="warning">@(notification.SuppressionReason ?? "Suppressed")</span>
                                    }
                                    else
                                    {
                                        <span>No</span>
                                    }
                                </td>
                                <td data-label="Recipients">
                                    @if (notification.Deliveries.Count == 0)
                                    {
                                        @:—
                                    }
                                    else
                                    {
                                        <ul class="notification-recipients">
                                            @foreach (var delivery in notification.Deliveries)
                                            {
                                                <li>
                                                    <span class="badge" data-status="@DeliveryBadge(delivery.State)">@delivery.State</span>
                                                    @if (incident.CanManage)
                                                    {
                                                        <span>@delivery.NormalizedRecipient</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
