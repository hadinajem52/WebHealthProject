@model IncidentDetailsViewModel
@using WebHealth.Application.Incidents
@{
    ViewData.SetTitle("Incident details");
    ViewData.SetBreadcrumbs(new BreadcrumbItem("Incidents", "/Incidents"), new BreadcrumbItem("Details"));
    var incident = Model.Incident;
    var isGlobal = User.IsInRole("Administrator") || User.IsInRole("Operations");
    var isAdministrator = User.IsInRole("Administrator");
    var isActive = incident.Status is "Open" or "Acknowledged" or "InProgress" or "MonitoringRecovery";

    var incidentStatus = StatusBadges.ForIncidentStatus(incident.Status);

    // Each flag reproduces exactly the condition the form was rendered under before, so
    // moving the controls into a menu and a separate card cannot widen what anyone can do.
    var canAcknowledge = incident.CanManage && incident.Status == "Open";
    var canStartProgress = incident.CanManage && incident.Status == "Acknowledged";
    var canCloseIncident = incident.CanManage && incident.Status == "Resolved";
    var hasQuickActions = canAcknowledge || canStartProgress || canCloseIncident;

    var canResolve = incident.CanManage && isActive;
    var canAddNote = incident.CanManage && incident.Status != "Closed";
    var canReassign = incident.CanManage && isGlobal && incident.Status != "Closed" && Model.OwnerOptions.Count > 0;
    var canForceClose = isAdministrator && incident.Status != "Closed";
    var canReopen = isAdministrator && incident.Status == "Closed";
    var hasManageForms = canResolve || canAddNote || canReassign || canForceClose || canReopen;

    static string StatusIcon(string status) => status switch
    {
        "success" => "success",
        "danger" => "error",
        _ => "warning"
    };

    static string DeliveryBadge(string state) => state switch
    {
        "Sent" => "success",
        "FailedPermanently" => "danger",
        "Suppressed" => "warning",
        _ => "warning"
    };
}

<div id="ajax-page" class="stack" data-ajax-region data-incident-workspace>
    <section class="card">
        <div class="page-intro">
            <div>
                <h2 class="card__title target-url">@incident.EndpointDisplayUrl</h2>
                <p class="card__status" data-status="@incidentStatus">
                    @await Html.PartialAsync("_Icon", StatusIcon(incidentStatus))
                    <span>@IssueDisplay.Describe(incident.IssueKey) &middot; @IncidentStatusDisplay.Name(incident.Status)</span>
                </p>
                <p class="card__subtitle">@incident.ClientName / @incident.WebsiteName / @incident.EnvironmentName</p>
                <p class="card__subtitle code">@incident.IssueKey</p>
            </div>
            <div class="form-actions">
                @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(StatusBadges.ForSeverity(incident.Severity), incident.Severity))
                @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(incidentStatus, incident.Status))

                @if (hasQuickActions)
                {
                    <div class="action-menu" data-shell-menu data-open="false">
                        <button type="button"
                                class="button button--primary"
                                data-shell-menu-toggle
                                aria-controls="incident-actions-menu"
                                aria-expanded="false"
                                aria-haspopup="true">
                            @await Html.PartialAsync("_Icon", "settings")
                            <span>Actions</span>
                            <span class="button__caret">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                        </button>

                        <div class="action-menu__panel" id="incident-actions-menu" data-shell-menu-panel>
                            @if (canAcknowledge)
                            {
                                <form asp-action="Acknowledge" method="post" data-ajax-form data-ajax-target="#ajax-page">
                                    <input type="hidden" name="id" value="@incident.Id" />
                                    <input type="hidden" name="version" value="@incident.Version" />
                                    <button class="action-menu__item" type="submit">
                                        @await Html.PartialAsync("_Icon", "check")
                                        <span>Acknowledge</span>
                                    </button>
                                </form>
                            }
                            @if (canStartProgress)
                            {
                                <form asp-action="StartProgress" method="post" data-ajax-form data-ajax-target="#ajax-page">
                                    <input type="hidden" name="id" value="@incident.Id" />
                                    <input type="hidden" name="version" value="@incident.Version" />
                                    <button class="action-menu__item" type="submit">
                                        @await Html.PartialAsync("_Icon", "play")
                                        <span>Start progress</span>
                                    </button>
                                </form>
                            }
                            @if (canCloseIncident)
                            {
                                <form asp-action="Close" method="post" data-ajax-form data-ajax-target="#ajax-page">
                                    <input type="hidden" name="id" value="@incident.Id" />
                                    <input type="hidden" name="version" value="@incident.Version" />
                                    <button class="action-menu__item" type="submit">
                                        @await Html.PartialAsync("_Icon", "archive")
                                        <span>Close incident</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="detail-list">
            <div class="detail-list__head" aria-hidden="true">
                <span>Subject</span>
                <span>Status</span>
            </div>
            <ul class="detail-list__items">
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "person")</span>
                            <span>Owner</span>
                        </span>
                        <span class="detail-list__value">@incident.OwnerDisplayName</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                            <span>Opened</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.OpenedAt)</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "check")</span>
                            <span>Acknowledged</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.AcknowledgedAt, "Not yet")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "restore")</span>
                            <span>Recovery started</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.RecoveryStartedAt, "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "shield-check")</span>
                            <span>Resolved</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.ResolvedAt, "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "archive")</span>
                            <span>Closed</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(incident.ClosedAt, "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "speed")</span>
                            <span>Outage duration</span>
                        </span>
                        <span class="detail-list__value">@(incident.OutageDurationMs is { } outage ? $"{TimeSpan.FromMilliseconds(outage):g}" : "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "reports")</span>
                            <span>Recurrence</span>
                        </span>
                        <span class="detail-list__value">@incident.RecurrenceCount</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "audit")</span>
                            <span>Resolution</span>
                        </span>
                        <span class="detail-list__value">
                            <span>@(incident.ResolutionCategory ?? "—")</span>
                            @if (incident.ResolutionNote is not null)
                            {
                                <span class="detail-list__note">@incident.ResolutionNote</span>
                            }
                        </span>
                    </div>
                </li>
            </ul>
        </div>
    </section>

    @if (hasManageForms)
    {
        <section class="card">
            <div class="page-intro">
                <div>
                    <h3 class="card__title">Manage incident</h3>
                    <p class="card__status" data-status="neutral">
                        @await Html.PartialAsync("_Icon", "pencil")
                        <span>Actions that record a reason or a note</span>
                    </p>
                </div>
            </div>

            @if (canResolve)
            {
                <form asp-action="Resolve" method="post" class="lifecycle-action-form" data-ajax-form data-ajax-target="#ajax-page">
                    <input type="hidden" name="id" value="@incident.Id" />
                    <input type="hidden" name="version" value="@incident.Version" />
                    <div class="form-field"><label for="resolve-category">Resolution category</label><input id="resolve-category" type="text" name="category" maxlength="@IncidentLifecycleEngine.MaximumCategoryLength" required /></div>
                    <div class="form-field"><label for="resolve-note">Resolution note</label><textarea id="resolve-note" name="note" maxlength="@IncidentLifecycleEngine.MaximumNoteLength" required></textarea></div>
                    <button class="button button--primary" type="submit">
                        @await Html.PartialAsync("_Icon", "shield-check")
                        <span>Resolve incident</span>
                    </button>
                </form>
            }
            @if (canAddNote)
            {
                <form asp-action="AddNote" method="post" class="lifecycle-action-form" data-ajax-form data-ajax-target="#ajax-page">
                    <input type="hidden" name="id" value="@incident.Id" />
                    <input type="hidden" name="version" value="@incident.Version" />
                    <div class="form-field"><label for="add-note">Note</label><textarea id="add-note" name="note" maxlength="@IncidentLifecycleEngine.MaximumNoteLength" required></textarea></div>
                    <button class="button button--secondary" type="submit">
                        @await Html.PartialAsync("_Icon", "plus")
                        <span>Add note</span>
                    </button>
                </form>
            }
            @if (canReassign)
            {
                <form asp-action="Reassign" method="post" class="lifecycle-action-form" data-ajax-form data-ajax-target="#ajax-page">
                    <input type="hidden" name="id" value="@incident.Id" />
                    <input type="hidden" name="version" value="@incident.Version" />
                    <div class="form-field">
                        <label for="reassign-owner">New owner</label>
                        <select id="reassign-owner" name="ownerSubjectId" required>
                            @foreach (var owner in Model.OwnerOptions)
                            {
                                <option value="@owner.OwnerSubjectId">@owner.DisplayName</option>
                            }
                        </select>
                    </div>
                    <button class="button button--secondary" type="submit">
                        @await Html.PartialAsync("_Icon", "person")
                        <span>Reassign</span>
                    </button>
                </form>
            }
            @if (canForceClose)
            {
                <form asp-action="ForceClose" method="post" class="lifecycle-action-form" data-ajax-form data-ajax-target="#ajax-page">
                    <input type="hidden" name="id" value="@incident.Id" />
                    <input type="hidden" name="version" value="@incident.Version" />
                    <div class="form-field"><label for="force-close-reason">Administrator reason</label><textarea id="force-close-reason" name="reason" maxlength="@IncidentLifecycleEngine.MaximumAdministratorReasonLength" required></textarea></div>
                    <button class="button button--danger" type="submit">
                        @await Html.PartialAsync("_Icon", "power")
                        <span>Force close</span>
                    </button>
                </form>
            }
            @if (canReopen)
            {
                <form asp-action="Reopen" method="post" class="lifecycle-action-form" data-ajax-form data-ajax-target="#ajax-page">
                    <input type="hidden" name="id" value="@incident.Id" />
                    <input type="hidden" name="version" value="@incident.Version" />
                    <div class="form-field"><label for="reopen-reason">Administrator reason</label><textarea id="reopen-reason" name="reason" maxlength="@IncidentLifecycleEngine.MaximumAdministratorReasonLength" required></textarea></div>
                    <button class="button button--secondary" type="submit">
                        @await Html.PartialAsync("_Icon", "restore")
                        <span>Reopen</span>
                    </button>
                </form>
            }
        </section>
    }

    <section class="card">
        <div class="page-intro">
            <div>
                <h3 class="card__title">Timeline</h3>
                <p class="card__status" data-status="neutral">
                    @await Html.PartialAsync("_Icon", "clock")
                    <span>Append-only history &middot; @incident.Timeline.Count event@(incident.Timeline.Count == 1 ? null : "s")</span>
                </p>
            </div>
        </div>
        @if (incident.Timeline.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "No timeline events",
                "Status changes, reassignments and notes will appear here as they happen.",
                "clock"))
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table data-table--history">
                    <caption class="visually-hidden">Incident timeline</caption>
                    <thead>
                        <tr>
                            <th scope="col">Subject</th>
                            <th scope="col">Detail</th>
                            <th scope="col">Actor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in incident.Timeline)
                        {
                            <tr>
                                <td data-label="Subject">
                                    <span class="history-cell">
                                        @await Html.PartialAsync("_HistoryMark", StatusBadges.Neutral)
                                        <span class="history-cell__subject">@IncidentEventDisplay.Name(entry.EventType)</span>
                                        <span class="history-cell__time">@Html.TimestampWithSeconds(entry.OccurredAt)</span>
                                    </span>
                                </td>
                                <td data-label="Detail">
                                    @if (entry.EventType == "StatusChanged")
                                    {
                                        @:@entry.FromStatus → @entry.ToStatus
                                    }
                                    else if (entry.EventType == "Reassigned")
                                    {
                                        @:@entry.FromOwnerDisplayName → @entry.ToOwnerDisplayName
                                    }
                                    else if (entry.Note is not null)
                                    {
                                        @entry.Note
                                    }
                                    else
                                    {
                                        @:—
                                    }
                                </td>
                                <td data-label="Actor">@(entry.ActorDisplayName ?? "System")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="page-intro">
            <div>
                <h3 class="card__title">Evidence</h3>
                <p class="card__status" data-status="neutral">
                    @await Html.PartialAsync("_Icon", "audit")
                    <span>Bounded snapshots &middot; @incident.Evidence.Count item@(incident.Evidence.Count == 1 ? null : "s")</span>
                </p>
            </div>
        </div>
        @if (incident.Evidence.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "No evidence recorded",
                "Snapshots are captured at each confirmation step.",
                "empty"))
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">Incident evidence</caption>
                    <thead><tr><th scope="col">Captured</th><th scope="col">Type</th><th scope="col">Role</th></tr></thead>
                    <tbody>
                        @foreach (var item in incident.Evidence)
                        {
                            <tr>
                                <td data-label="Captured">@Html.TimestampWithSeconds(item.CapturedAt)</td>
                                <td data-label="Type"><span class="tag">@item.EvidenceType</span></td>
                                <td data-label="Role">@item.EvidenceRole</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="page-intro">
            <div>
                <h3 class="card__title">Notifications</h3>
                <p class="card__status" data-status="neutral">
                    @await Html.PartialAsync("_Icon", "bell")
                    <span>Delivery and suppression &middot; @incident.Notifications.Count notification@(incident.Notifications.Count == 1 ? null : "s")</span>
                </p>
            </div>
        </div>
        @if (incident.Notifications.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "No notifications yet",
                "Nothing this incident triggered has been sent or suppressed so far.",
                "bell"))
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">Notifications triggered by this incident</caption>
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Event</th>
                            <th scope="col">Suppressed</th>
                            <th scope="col">Recipients</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var notification in incident.Notifications)
                        {
                            <tr>
                                <td data-label="When">@Html.TimestampWithSeconds(notification.OccurredAt)</td>
                                <td data-label="Event"><span class="tag">@notification.EventType</span></td>
                                <td data-label="Suppressed">
                                    @if (notification.IsSuppressed)
                                    {
                                        <span class="badge" data-status="warning">@(notification.SuppressionReason ?? "Suppressed")</span>
                                    }
                                    else
                                    {
                                        <span>No</span>
                                    }
                                </td>
                                <td data-label="Recipients">
                                    @if (notification.Deliveries.Count == 0)
                                    {
                                        @:—
                                    }
                                    else
                                    {
                                        <ul class="notification-recipients">
                                            @foreach (var delivery in notification.Deliveries)
                                            {
                                                <li>
                                                    <span class="badge" data-status="@DeliveryBadge(delivery.State)">@delivery.State</span>
                                                    @if (incident.CanManage)
                                                    {
                                                        <span>@delivery.NormalizedRecipient</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
