@model IncidentListViewModel
@{
    ViewData.SetTitle("Incidents");
    ViewData.SetBreadcrumbs(new BreadcrumbItem("Incidents"));
    var listPage = Model.Page;
    var firstVisible = listPage.TotalCount == 0 ? 0 : ((listPage.Page - 1) * listPage.PageSize) + 1;
    var lastVisible = Math.Min(listPage.Page * listPage.PageSize, listPage.TotalCount);
    var hasPrevious = listPage.Page > 1;
    var hasNext = lastVisible < listPage.TotalCount;
}

<div class="stack">
    @* No card title here: the page heading already reads "Incidents". This card is the control
       that scopes the list below it, so it carries only the explanation and the filters. *@
    <section class="card" aria-labelledby="incidents-scope-label">
        <p class="card__subtitle" id="incidents-scope-label">
            Confirmed availability issues across your assigned targets. An incident opens only
            after a failure is confirmed, so every row here is a repeated result rather than one
            bad response.
        </p>

        <form method="get" class="filter-bar">
            <div class="form-field">
                <label asp-for="Status">Status</label>
                <select asp-for="Status">
                    <option value="">Any</option>
                    <option value="Open">Open</option>
                    <option value="Acknowledged">Acknowledged</option>
                    <option value="InProgress">In progress</option>
                    <option value="MonitoringRecovery">Monitoring recovery</option>
                    <option value="Resolved">Resolved</option>
                    <option value="Closed">Closed</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Severity">Severity</label>
                <select asp-for="Severity">
                    <option value="">Any</option>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Warning">Warning</option>
                </select>
            </div>
            <label class="switch-field filter-bar__switch">
                <input asp-for="UnacknowledgedOnly" type="checkbox" />
                <span>Unacknowledged only</span>
            </label>
            <div class="filter-bar__actions">
                <button class="button button--primary" type="submit">
                    @await Html.PartialAsync("_Icon", "filter")
                    <span>Apply filters</span>
                </button>
                @* Offered only when something is applied: a Clear control on an unfiltered list
                   is an action with nothing to do. *@
                @if (Model.HasFilters)
                {
                    <a class="button button--secondary" asp-action="Index">
                        @await Html.PartialAsync("_Icon", "close")
                        <span>Clear</span>
                    </a>
                }
            </div>
        </form>
    </section>

    @if (listPage.Items.Count == 0)
    {
        <section class="card">
            @* An empty list means two different things, and they need different words: nothing
               matched what you asked for, or nothing has gone wrong at all. *@
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                Model.HasFilters
                    ? "No incidents match these filters"
                    : "No incidents have been opened",
                Model.HasFilters
                    ? "Clear the filters to see every incident on your assigned targets."
                    : "Incidents open automatically when a monitored endpoint confirms a failure.",
                "incidents"))
        </section>
    }
    else
    {
        <section class="card" aria-labelledby="incidents-results-heading">
            <div class="page-intro">
                <div>
                    <h3 class="card__title" id="incidents-results-heading">Confirmed incidents</h3>
                    @* The total across every page, which is what the reader is selecting from.
                       Anything derived from this page's rows would read as a total and be wrong. *@
                    <p class="card__status" data-status="neutral">
                        @await Html.PartialAsync("_Icon", "incidents")
                        <span>@listPage.TotalCount incident@(listPage.TotalCount == 1 ? null : "s")</span>
                    </p>
                </div>
            </div>

            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">Incidents visible to your account</caption>
                    <thead>
                        <tr>
                            <th scope="col">Endpoint</th>
                            <th scope="col">Issue</th>
                            <th scope="col">Severity</th>
                            <th scope="col">Status</th>
                            <th scope="col">Opened</th>
                            <th scope="col">Owner</th>
                            <th scope="col"><span class="visually-hidden">Details</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in listPage.Items)
                        {
                            <tr>
                                <td data-label="Endpoint">
                                    <span class="data-table__primary target-url">@item.EndpointDisplayUrl</span>
                                    <span class="data-table__secondary">@item.ClientName / @item.WebsiteName / @item.EnvironmentName</span>
                                </td>

                                @* The issue key was a native title tooltip on the cell, which is
                                   invisible until hovered and unreachable by keyboard. It is an
                                   identifier a reader may need to quote, so it is shown. *@
                                <td data-label="Issue">
                                    <span class="data-table__primary">@IssueDisplay.Describe(item.IssueKey)</span>
                                    <span class="data-table__secondary">@item.IssueKey</span>
                                </td>

                                <td data-label="Severity">
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                        StatusBadges.ForSeverity(item.Severity),
                                        item.Severity))
                                </td>

                                @* Status, its label and the two facts that qualify it, in one
                                   badge each. Loose secondary lines under a badge are what made
                                   these rows read as unaligned blocks rather than a table. *@
                                <td data-label="Status">
                                    <span class="badge-set">
                                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                            StatusBadges.ForIncidentStatus(item.Status),
                                            IncidentStatusDisplay.Name(item.Status),
                                            item.AcknowledgedAt is { } acknowledged
                                                ? $"Acknowledged {acknowledged:yyyy-MM-dd HH:mm} UTC"
                                                : null))

                                        @if (item.AcknowledgedAt is null
                                            && item.Status != "Resolved"
                                            && item.Status != "Closed")
                                        {
                                            @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                                StatusBadges.Warning,
                                                "Unacknowledged",
                                                "Nobody has taken this incident yet. Acknowledging it records who is looking."))
                                        }

                                        @if (item.RecurrenceCount > 0)
                                        {
                                            @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                                StatusBadges.Neutral,
                                                $"Recurrence {item.RecurrenceCount}",
                                                "This endpoint has failed the same way before. The count is how many times "
                                                + "the issue reopened rather than opening as a new incident."))
                                        }
                                    </span>
                                </td>

                                <td data-label="Opened">@Html.Timestamp(item.OpenedAt)</td>
                                <td data-label="Owner">@item.OwnerDisplayName</td>
                                <td data-label="Details">
                                    <a class="button button--secondary" asp-action="Details" asp-route-id="@item.Id">
                                        <span>View</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pagination" aria-label="Incident pages">
                <span>Showing @firstVisible–@lastVisible of @listPage.TotalCount</span>
                <span class="pagination__actions">
                    @if (hasPrevious)
                    {
                        <a class="button button--secondary" asp-route-page="@(listPage.Page - 1)" asp-route-status="@Model.Status" asp-route-severity="@Model.Severity" asp-route-unacknowledgedOnly="@Model.UnacknowledgedOnly">
                            @await Html.PartialAsync("_Icon", "arrow-left")
                            <span>Previous</span>
                        </a>
                    }
                    @if (hasNext)
                    {
                        <a class="button button--secondary" asp-route-page="@(listPage.Page + 1)" asp-route-status="@Model.Status" asp-route-severity="@Model.Severity" asp-route-unacknowledgedOnly="@Model.UnacknowledgedOnly">
                            <span>Next</span>
                            @await Html.PartialAsync("_Icon", "arrow-right")
                        </a>
                    }
                </span>
            </nav>
        </section>
    }
</div>
