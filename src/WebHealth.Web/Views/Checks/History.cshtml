@model CheckHistoryViewModel
@{
    ViewData.SetTitle("Check history");
    ViewData.SetBreadcrumbs(Breadcrumbs.Registry(Url), Breadcrumbs.Endpoints(Url), Breadcrumbs.Endpoint(Url, Model.Page.EndpointId, Model.Page.EndpointDisplayUrl), new BreadcrumbItem("Check history"));
    var history = Model.Page;
    var firstVisible = history.TotalCount == 0 ? 0 : ((history.Page - 1) * history.PageSize) + 1;
    var lastVisible = Math.Min(history.Page * history.PageSize, history.TotalCount);
    var hasPrevious = history.Page > 1;
    var hasNext = lastVisible < history.TotalCount;
    var anyInFlight = history.Items.Any(item => item.State != LogicalCheckStates.Completed);
}


<div id="ajax-page"
     class="stack"
     data-ajax-region
     data-run-scope="#ajax-page"
     data-run-status
     data-run-active="@(anyInFlight ? "true" : "false")"
     data-run-url="@Url.Action("History", new { id = history.EndpointId, page = history.Page })"
     data-run-lifetime="120000">
    <section class="card">
        <div class="page-intro">
            <div>
                <h2 class="card__title target-url">@history.EndpointDisplayUrl</h2>
                <p class="card__status" data-status="neutral">
                    @await Html.PartialAsync("_Icon", "clock")
                    <span>Check history &middot; @history.TotalCount check@(history.TotalCount == 1 ? null : "s")</span>
                </p>
            </div>
            <div class="page-intro__actions">
                <div class="form-actions">
                    <a class="button button--secondary"
                       asp-controller="Targets"
                       asp-action="Endpoint"
                       asp-route-id="@history.EndpointId">
                        @await Html.PartialAsync("_Icon", "arrow-left")
                        <span>Back to endpoint</span>
                    </a>
                </div>
                @await Html.PartialAsync("_ClearHistoryAction", new ClearHistoryActionViewModel(
                        Url.Action("ClearHistory", new { id = history.EndpointId })!,
                        Url.Action("Archived", new { id = history.EndpointId })!,
                        Model.CanArchive,
                        history.Items.Any(item => item.State == LogicalCheckStates.Completed),
                        "Moves every completed check for this endpoint out of this list into the archive. Nothing is deleted, archived checks still count towards uptime, and each one can be restored.",
                    "Move every completed check for this endpoint to the archive?",
                    "#ajax-page"))
            </div>
        </div>

        @if (history.Items.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel(
                "No checks yet",
                "Run a check now, or wait for the next scheduled run.",
                "clock"))
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table data-table--history">
                    <caption class="visually-hidden">Scheduled and manual checks for this endpoint</caption>
                    <thead>
                        <tr>
                            <th scope="col">Subject</th>
                            <th scope="col">Initiator</th>
                            <th scope="col">Outcome</th>
                            <th scope="col">Duration</th>
                            <th scope="col">Monitor source</th>
                            <th scope="col">HTTP status</th>
                            <th scope="col">Uptime</th>
                            <th scope="col"><span class="visually-hidden">Details</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in history.Items)
                        {
                            var itemInFlight = item.State != LogicalCheckStates.Completed;
                            var itemTone = itemInFlight ? StatusBadges.Info : StatusBadges.ForOutcome(item.Outcome);
                            <tr>
                                <td data-label="Subject">
                                    <span class="history-cell">
                                        @await Html.PartialAsync("_HistoryMark", itemTone)
                                        <span class="history-cell__subject">@item.Source check</span>
                                        <span class="history-cell__time">@Html.TimestampWithSeconds((item.ScheduledFor ?? item.RequestedAt), "—")</span>
                                    </span>
                                </td>
                                <td data-label="Initiator">@(item.InitiatedByDisplayName ?? "—")</td>
                                <td data-label="Outcome">
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                        itemTone,
                                        item.Outcome ?? item.State,
                                        item.FailureCategory,
                                        itemInFlight,
                                        $"check-history-{item.LogicalCheckId}"))
                                    @if (item.CurrentStateDisposition is "Superseded" or "Ineligible")
                                    {
                                        @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(
                                            StatusBadges.Info, item.CurrentStateDisposition,
                                            "Historical evidence; current health and incidents were not changed."))
                                    }
                                    @foreach (var incident in item.KnownIncidents)
                                    {
                                        <a class="known-issue" asp-controller="Incidents" asp-action="Details" asp-route-id="@incident.IncidentId"
                                           title="Acknowledged @incident.AcknowledgedAt.ToString("u") · Current incident status: @incident.Status">
                                            @IssueDisplay.Describe(incident.IssueKey) · @IncidentStatusDisplay.Name(incident.Status)
                                        </a>
                                    }
                                </td>
                                <td data-label="Duration">@(item.TotalDurationMs is { } duration ? $"{duration} ms" : "—")</td>
                                <td data-label="Monitor source" title="@item.MonitorSource">@MonitorSourceDisplay.Name(item.MonitorSource)</td>
                                <td data-label="HTTP status">@(item.HttpStatus?.ToString() ?? "—")</td>
                                <td data-label="Uptime">@(item.CountsForUptime ? "Counts" : "Excluded")</td>
                                <td class="data-table__action" data-label="Details">
                                    <a asp-action="Check" asp-route-id="@item.LogicalCheckId">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pagination" aria-label="Check history pages">
                <span>Showing @firstVisible–@lastVisible of @history.TotalCount</span>
                <span class="pagination__actions">
                    @if (hasPrevious)
                    {
                        <a class="button button--secondary" asp-route-id="@history.EndpointId" asp-route-page="@(history.Page - 1)" data-ajax-link data-ajax-target="#ajax-page">
                            @await Html.PartialAsync("_Icon", "arrow-left")
                            <span>Previous</span>
                        </a>
                    }
                    @if (hasNext)
                    {
                        <a class="button button--secondary" asp-route-id="@history.EndpointId" asp-route-page="@(history.Page + 1)" data-ajax-link data-ajax-target="#ajax-page">
                            <span>Next</span>
                            @await Html.PartialAsync("_Icon", "arrow-right")
                        </a>
                    }
                </span>
            </nav>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/poller.js" asp-append-version="true"></script>
    <script src="~/js/run-status.js" asp-append-version="true"></script>
}
