@model CheckDetailsViewModel
@{
    ViewData.SetTitle("Check details");
    ViewData.SetBreadcrumbs(Breadcrumbs.Registry(Url), Breadcrumbs.Endpoints(Url), Breadcrumbs.Endpoint(Url, Model.Check.EndpointId, Model.Check.EndpointDisplayUrl), new BreadcrumbItem("Check history", Url.Action("History", new { id = Model.Check.EndpointId })), new BreadcrumbItem("Check details"));
    var check = Model.Check;
    var hasResult = check.Outcome is not null;
    var inFlight = check.State != LogicalCheckStates.Completed;
    var outcomeStatus = inFlight ? StatusBadges.Info : StatusBadges.ForOutcome(check.Outcome);

    static string StatusIcon(string status) => status switch
    {
        "success" => "success",
        "danger" => "error",
        _ => "warning"
    };
}


<div id="ajax-page"
     class="stack"
     data-ajax-region
     data-run-scope="#ajax-page"
     data-run-status
     data-run-active="@(inFlight ? "true" : "false")"
     data-run-url="@Url.Action("Check", new { id = check.LogicalCheckId })"
     data-run-lifetime="120000">
    <section class="card">
        <div class="page-intro">
            <div>
                <h2 class="card__title target-url">@check.EndpointDisplayUrl</h2>
                <p class="card__status" data-status="@outcomeStatus">
                    @if (inFlight)
                    {
                        @await Html.PartialAsync("_Spinner", $"check-summary-{check.LogicalCheckId}")
                    }
                    else
                    {
                        @await Html.PartialAsync("_Icon", StatusIcon(outcomeStatus))
                    }
                    <span>Check outcome &middot; @(check.Outcome ?? check.State)</span>
                </p>
            </div>
            <div class="form-actions">
                <a class="button button--secondary" asp-action="History" asp-route-id="@check.EndpointId">
                    @await Html.PartialAsync("_Icon", "arrow-left")
                    <span>Back to history</span>
                </a>
            </div>
        </div>

        <div class="detail-list">
            <div class="detail-list__head" aria-hidden="true">
                <span>Subject</span>
                <span>Status</span>
            </div>
            <ul class="detail-list__items">
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "play")</span>
                            <span>Source</span>
                        </span>
                        <span class="detail-list__value">@check.Source</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "person")</span>
                            <span>Initiator</span>
                        </span>
                        <span class="detail-list__value">@(check.InitiatedByDisplayName ?? "System schedule")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "restore")</span>
                            <span>State</span>
                        </span>
                        <span class="detail-list__value">@check.State</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "calendar")</span>
                            <span>@(check.ScheduledFor is not null ? "Scheduled for" : "Requested at")</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(check.ScheduledFor ?? check.RequestedAt)</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                            <span>Started</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(check.StartedAt, "Not started")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "check")</span>
                            <span>Completed</span>
                        </span>
                        <span class="detail-list__value">@Html.TimestampWithSeconds(check.CompletedAt, "Not completed")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "activity")</span>
                            <span>Outcome</span>
                        </span>
                        <span class="detail-list__value">@await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(outcomeStatus, check.Outcome ?? check.State, check.FailureCategory is null ? null : IssueDisplay.DescribeRule($"Http.{check.FailureCategory}"), inFlight, $"check-detail-{check.LogicalCheckId}"))</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "warning")</span>
                            <span>Failure category</span>
                        </span>
                        <span class="detail-list__value">
                            @(check.FailureCategory is null
                                ? "None"
                                : IssueDisplay.DescribeRule($"Http.{check.FailureCategory}"))
                        </span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "diagnostics")</span>
                            <span>HTTP status</span>
                        </span>
                        <span class="detail-list__value">@(check.HttpStatus?.ToString() ?? "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "speed")</span>
                            <span>Duration</span>
                        </span>
                        <span class="detail-list__value">@(check.TotalDurationMs is { } total ? $"{total} ms" : "—")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "reports")</span>
                            <span>Counts toward uptime</span>
                        </span>
                        <span class="detail-list__value">@(check.CountsForUptime ? "Yes" : "No")</span>
                    </div>
                </li>
                <li>
                    <div class="detail-list__row">
                        <span class="detail-list__subject">
                            <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "information")</span>
                            <span>Safe diagnostic</span>
                        </span>
                        <span class="detail-list__value">@(check.SafeDiagnostic ?? "None recorded")</span>
                    </div>
                </li>
            </ul>
        </div>

        @foreach (var incident in check.KnownIncidents)
        {
            <div class="known-issue-banner" role="status">
                <span>
                    <strong>@IssueDisplay.Describe(incident.IssueKey) · @IncidentStatusDisplay.Name(incident.Status)</strong>
                    This result is evidence for an acknowledged incident. The check remains @check.Outcome because the issue is still present.
                </span>
                <a asp-controller="Incidents" asp-action="Details" asp-route-id="@incident.IncidentId">View incident</a>
            </div>
        }
    </section>

    @if (hasResult)
    {
        <section class="card">
            <div class="page-intro">
                <div>
                    <h3 class="card__title">Timing and response</h3>
                    <p class="card__status" data-status="neutral">
                        @await Html.PartialAsync("_Icon", "speed")
                        <span>Timing breakdown &middot; @(check.TotalDurationMs is { } elapsed ? $"{elapsed} ms total" : "no total recorded")</span>
                    </p>
                </div>
            </div>
            <div class="detail-list">
                <div class="detail-list__head" aria-hidden="true">
                    <span>Subject</span>
                    <span>Status</span>
                </div>
                <ul class="detail-list__items">
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "search")</span>
                                <span>DNS</span>
                            </span>
                            <span class="detail-list__value">@(check.DnsDurationMs is { } dns ? $"{dns} ms" : "—")</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "link")</span>
                                <span>Connect</span>
                            </span>
                            <span class="detail-list__value">@(check.ConnectDurationMs is { } connect ? $"{connect} ms" : "—")</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "shield-check")</span>
                                <span>TLS</span>
                            </span>
                            <span class="detail-list__value">@(check.TlsDurationMs is { } tls ? $"{tls} ms" : "—")</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "speed")</span>
                                <span>Time to first byte</span>
                            </span>
                            <span class="detail-list__value">@(check.TtfbDurationMs is { } ttfb ? $"{ttfb} ms" : "—")</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "audit")</span>
                                <span>Page size</span>
                            </span>
                            <span class="detail-list__value">@(check.DecodedLength is { } length ? $"{length:N0} bytes" : "—")
                                @if (check.LengthSource is not null)
                                {
                                    <span class="detail-list__note">Measured as @check.LengthSource</span>
                                }
                            </span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "archive")</span>
                                <span>Transferred length</span>
                            </span>
                            <span class="detail-list__value">@(check.TransferredLength is { } transferred ? $"{transferred:N0} bytes" : "Not advertised")</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "warning")</span>
                                <span>Response truncated</span>
                            </span>
                            <span class="detail-list__value">@(check.ResponseTruncated ? "Yes" : "No")</span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "diagnostics")</span>
                                <span>Monitor source</span>
                            </span>
                            <span class="detail-list__value"><span title="@check.MonitorSource">@MonitorSourceDisplay.Name(check.MonitorSource)</span></span>
                        </div>
                    </li>
                    <li>
                        <div class="detail-list__row">
                            <span class="detail-list__subject">
                                <span class="detail-list__icon">@await Html.PartialAsync("_Icon", "clock")</span>
                                <span>Measured at</span>
                            </span>
                            <span class="detail-list__value">@Html.TimestampWithSeconds(check.MeasuredAt)</span>
                        </div>
                    </li>
                </ul>
            </div>
        </section>
    }

    <section class="card">
        <div class="page-intro">
            <div>
                <h3 class="card__title">Findings</h3>
                <p class="card__status" data-status="@(check.Findings.Count == 0 ? "success" : "warning")">
                    @await Html.PartialAsync("_Icon", check.Findings.Count == 0 ? "success" : "warning")
                    <span>Findings &middot; @check.Findings.Count recorded</span>
                </p>
            </div>
        </div>
        @if (check.Findings.Count == 0)
        {
            <p class="data-table__secondary">No findings recorded.</p>
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">Findings recorded for this check</caption>
                    <thead>
                        <tr>
                            <th scope="col">Rule</th>
                            <th scope="col">Severity</th>
                            <th scope="col">Observed</th>
                            <th scope="col">Expected</th>
                            <th scope="col">Issue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var finding in check.Findings)
                        {
                            <tr>
                                <td data-label="Rule" title="@finding.RuleKey">@IssueDisplay.DescribeRule(finding.RuleKey)</td>
                                <td data-label="Severity">@await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel(StatusBadges.ForSeverity(finding.Severity), finding.Severity))</td>
                                <td data-label="Observed">@(finding.ObservedValue ?? "—")</td>
                                <td data-label="Expected">@(finding.ExpectedValue ?? "—")</td>
                                <td data-label="Issue" title="@finding.IssueKey">@IssueDisplay.Describe(finding.IssueKey)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="page-intro">
            <div>
                <h3 class="card__title">Redirect chain</h3>
                <p class="card__status" data-status="neutral">
                    @await Html.PartialAsync("_Icon", "link")
                    <span>Redirect chain &middot; @check.RedirectHops.Count hop@(check.RedirectHops.Count == 1 ? null : "s")</span>
                </p>
            </div>
        </div>
        @if (check.RedirectHops.Count == 0)
        {
            <p class="data-table__secondary">No redirects recorded.</p>
        }
        else
        {
            <div class="table-scroll table-scroll--flush">
                <table class="data-table">
                    <caption class="visually-hidden">Redirect hops recorded for this check</caption>
                    <thead>
                        <tr>
                            <th scope="col">Hop</th>
                            <th scope="col">From</th>
                            <th scope="col">To</th>
                            <th scope="col">Status</th>
                            <th scope="col">Loop</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hop in check.RedirectHops)
                        {
                            <tr>
                                <td data-label="Hop">@hop.HopNumber</td>
                                <td data-label="From" class="target-url">@hop.FromUrl</td>
                                <td data-label="To" class="target-url">@hop.ToUrl</td>
                                <td data-label="Status">@hop.HttpStatus</td>
                                <td data-label="Loop">@(hop.IsLoop ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/poller.js" asp-append-version="true"></script>
    <script src="~/js/run-status.js" asp-append-version="true"></script>
}
