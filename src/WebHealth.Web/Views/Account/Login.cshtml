@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData.SetTitle("Sign in");
}

<section class="auth-card" aria-labelledby="sign-in-title">
    <div class="auth-card__brand">
        <span class="auth-card__mark">@await Html.PartialAsync("_Icon", "brand")</span>
        <span>WebHealth</span>
    </div>

    <div class="auth-card__heading">
        <p class="card__eyebrow">Protected workspace</p>
        <h1 id="sign-in-title">Welcome back</h1>
        <p>Sign in to manage websites, checks, and incidents.</p>
    </div>

    @await Html.PartialAsync("_ValidationSummary")

    <form asp-action="Login" method="post" class="auth-form">
        <input name="ReturnUrl" type="hidden" value="@Model.ReturnUrl" />

        <div class="form-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" inputmode="email" autofocus />
            <span asp-validation-for="Email"></span>
        </div>

        <div class="form-field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
        </div>

        <label class="check-field">
            <input asp-for="RememberMe" />
            <span>@Html.DisplayNameFor(model => model.RememberMe)</span>
        </label>

        <button type="submit" class="button button--primary auth-form__submit">Sign in</button>
    </form>
</section>
