@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData.SetTitle("Sign in");
}

<section class="auth-form-panel" aria-labelledby="sign-in-title">
    <div class="auth-heading">
        <h1 id="sign-in-title">Welcome Back</h1>
        <p>Enter your email and password to sign in</p>
    </div>

    <form asp-action="Login" method="post" class="auth-form">
        <input name="ReturnUrl" type="hidden" value="@Model.ReturnUrl" />

        @await Html.PartialAsync("_ValidationSummary")

        <div class="form-field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email"
                   placeholder="Your email address"
                   autocomplete="username"
                   inputmode="email"
                   autofocus />
            <span class="form-field__error" asp-validation-for="Email"></span>
        </div>

        <div class="form-field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password"
                   placeholder="Your password"
                   autocomplete="current-password" />
            <span class="form-field__error" asp-validation-for="Password"></span>
        </div>

        <label class="switch-field">
            <input asp-for="RememberMe" />
            <span>@Html.DisplayNameFor(model => model.RememberMe)</span>
        </label>

        <button type="submit" class="auth-form__submit">Sign in</button>
    </form>

    @* The product creates accounts through administration, so no self sign-up
       destination exists to link to. *@
    <p class="auth-note">Need an account? <strong>Ask an administrator</strong></p>
</section>
