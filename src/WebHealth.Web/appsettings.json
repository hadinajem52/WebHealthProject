{
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Monitoring": {
    "Scheduling": {
      "Enabled": true,
      "DispatchBatchSize": 50,
      "RecoveryBatchSize": 100,
      "RecoveryDelay": "00:02:00"
    },
    "HttpTransport": {
      "UserAgent": "WebHealthMonitor/1.0",
      "Contact": "https://github.com/hadinajem52/WebHealthProject"
    }
  },
  "Seo": {
    "Scheduling": {
      "Enabled": true,
      "RobotsTtlHours": 24,
      "RefreshBatchSize": 25,
      "FetchTimeoutSeconds": 15
    }
  },
  "PageAudits": {
    "Scheduling": {
      "Enabled": false,
      "WorkerCount": 1,
      "DispatchBatchSize": 10,
      "ReconciliationBatchSize": 25,
      "ReconciliationDelay": "00:05:00",
      "LeaseDuration": "00:05:00",
      "MaximumAttempts": 3
    },
    "PageSpeedInsights": {
      "Locale": "en-US",
      "RequestTimeout": "00:01:30",
      "MaximumResponseBytes": 10485760,
      "MaximumAuditCount": 500
    }
  },
  "Crawling": {
    "Scheduling": {
      "Enabled": true,
      "WorkerCount": 1,
      "RequestConcurrency": 2,
      "RequestsPerSecondPerHost": 2,
      "MaxDuration": "00:30:00",
      "FetchTimeoutSeconds": 15,
      "MaxPageBytes": 1048576
    }
  },
  "Maintenance": {
    "Scheduling": {
      "Enabled": true,
      "HorizonDays": 90,
      "BatchSize": 25
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
