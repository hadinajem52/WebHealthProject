{
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Monitoring": {
    "Scheduling": {
      "Enabled": true,
      "DispatchBatchSize": 50,
      "RecoveryBatchSize": 100,
      "RecoveryDelay": "00:02:00"
    },
    "HttpTransport": {
      "UserAgent": "WebHealthMonitor/1.0",
      "Contact": "https://github.com/hadinajem52/WebHealthProject"
    }
  },
  "Seo": {
    "Scheduling": {
      "Enabled": true,
      "RobotsTtlHours": 24,
      "RefreshBatchSize": 25,
      "FetchTimeoutSeconds": 15
    }
  },
  "PageAudits": {
    "Scheduling": {
      "Enabled": false,
      "WorkerCount": 2,
      "DispatchBatchSize": 10,
      "ReconciliationBatchSize": 25,
      "ReconciliationDelay": "00:05:00",
      "LeaseDuration": "00:05:00",
      "MaximumAttempts": 3
    },
    "PageSpeedInsights": {
      "Locale": "en-US",
      "RequestTimeout": "00:01:30",
      "MaximumResponseBytes": 10485760,
      "MaximumAuditCount": 500
    }
  },
  "Crawling": {
    "Scheduling": {
      "Enabled": true,
      "WorkerCount": 1,
      "RequestConcurrency": 2,
      "RequestsPerSecondPerHost": 2,
      "MaxDuration": "00:30:00",
      "FetchTimeoutSeconds": 15,
      "MaxPageBytes": 1048576
    }
  },
  "PngAudits": {
    "Enabled": true,
    "WorkerCount": 1,
    "MaxPages": 200,
    "MaxDepth": 5,
    "MaxPageBytes": 1048576,
    "MaxTotalPageBytes": 33554432,
    "MaxImageReferencesPerPage": 1000,
    "MaxUniqueImages": 500,
    "MaxTotalImageSourceMappings": 5000,
    "MaxImageBytes": 8388608,
    "MaxTotalImageBytes": 134217728,
    "MaxWidth": 10000,
    "MaxHeight": 10000,
    "MaxDecodedPixels": 40000000,
    "MaxDecodedMemoryBytes": 268435456,
    "MaxTotalHttpAttempts": 1500,
    "FetchTimeoutSeconds": 15,
    "RequestsPerSecondPerHost": 1,
    "TransientRetryCount": 1,
    "ImageFetchConcurrency": 1,
    "ImageDecodeConcurrency": 1,
    "ComparisonTimeoutSeconds": 60,
    "MaximumAttempts": 3,
    "LeaseDuration": "00:02:00",
    "HeartbeatInterval": "00:00:30",
    "ReconciliationDelay": "00:01:00",
    "ReconciliationBatchSize": 100,
    "MaxDuration": "00:30:00",
    "MinSavingsPercent": 10,
    "MinSavingsBytes": 4096
  },
  "Maintenance": {
    "Scheduling": {
      "Enabled": true,
      "HorizonDays": 90,
      "BatchSize": 25
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
