{
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Monitoring": {
    "HttpTransport": {
      "UserAgent": "WebHealthMonitor/1.0"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
